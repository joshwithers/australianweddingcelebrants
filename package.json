{
  "name": "wedding-directory",
  "version": "3.0.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/generate-agent-skills-index.mjs && astro build && node scripts/generate-markdown.mjs && node scripts/check-markdown-output.mjs",
    "check": "astro check",
    "lint": "astro check",
    "test": "npm run build && node --experimental-strip-types --test tests/*.test.mjs",
    "check:agent-files": "node scripts/check-agent-files.mjs",
    "check:dns-aid": "node scripts/check-dns-aid.mjs",
    "check:links": "node scripts/check-internal-links.mjs",
    "validate": "npm run lint && npm test && npm run check:agent-files && npm run check:links && npm audit --audit-level=low",
    "preview": "astro preview",
    "format": "prettier -w .",
    "generate:agent-skills-index": "node scripts/generate-agent-skills-index.mjs",
    "generate:location-blurbs": "node scripts/generate-location-blurbs.mjs",
    "probe:external-images": "node scripts/probe-external-images.mjs",
    "offline:external-images": "node scripts/offline-external-images.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/mdx": "^7.0.6",
    "@astrojs/react": "^6.0.3",
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.3",
    "date-fns": "^4.4.0",
    "github-slugger": "^2.0.0",
    "marked": "^18.0.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-lite-youtube-embed": "^3.6.0",
    "sanitize-html": "^2.17.7",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/sanitize-html": "^2.16.1",
    "gray-matter": "^4.0.3",
    "node-html-parser": "^7.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "probe-image-size": "^7.3.0",
    "sharp": "^0.35.3",
    "typescript": "^6.0.3"
  }
}
