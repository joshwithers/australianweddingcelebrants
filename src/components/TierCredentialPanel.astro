---
import { TIER_STANDARDS_CAVEAT } from "@/lib/tierStandards";
import type { TierCredentialInput } from "@/lib/utils/tierCredential";
import { getTierCredential } from "@/lib/utils/tierCredential";

interface Props {
  data: TierCredentialInput;
  tierLabel: string;
}

const { data, tierLabel } = Astro.props;
const credential = getTierCredential(data);
const evidenceStatusLabel = {
  current: "Current published evidence",
  stale: "Published evidence needs refreshing",
  incomplete: "Published evidence record incomplete",
};
---

<div
  class="border-border mt-5 border-t pt-5"
  data-tier-credential={credential.status}
  data-tier-issuer={credential.issuer}
>
  <h3 class="text-dark mb-2 text-sm" style="font-weight: 600;">
    {tierLabel} credential
  </h3>
  <dl class="grid gap-2 text-sm">
    <div>
      <dt class="text-dark inline" style="font-weight: 600;">Status:</dt>
      <dd class="inline">Issued and human verified</dd>
    </div>
    <div>
      <dt class="text-dark inline" style="font-weight: 600;">
        Issuer and source:
      </dt>
      <dd class="inline">
        {" "}
        <a href={credential.issuerUrl} class="underline">
          {credential.issuer}
        </a>
      </dd>
    </div>
    <div>
      <dt class="text-dark inline" style="font-weight: 600;">Verification:</dt>
      <dd class="inline">{credential.verificationMethod}</dd>
    </div>
  </dl>
  {
    credential.supportingEvidence && (
      <div class="mt-4">
        <h4 class="text-dark mb-2 text-sm" style="font-weight: 600;">
          Supporting external evidence
        </h4>
        <dl class="grid gap-2 text-sm">
          <div>
            <dt class="text-dark inline" style="font-weight: 600;">
              Status:
            </dt>
            <dd class="inline">
              {" "}
              {evidenceStatusLabel[credential.supportingEvidence.status]}
            </dd>
          </div>
          <div>
            <dt class="text-dark inline" style="font-weight: 600;">
              Source:
            </dt>
            <dd class="inline">
              {" "}
              {credential.supportingEvidence.sourceUrl ? (
                <a
                  href={credential.supportingEvidence.sourceUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="underline"
                >
                  {credential.supportingEvidence.source}
                </a>
              ) : (
                credential.supportingEvidence.source
              )}
            </dd>
          </div>
          <div>
            <dt class="text-dark inline" style="font-weight: 600;">
              Last checked:
            </dt>
            <dd class="inline">
              {" "}
              {credential.supportingEvidence.lastCheckedLabel}
            </dd>
          </div>
        </dl>
        {credential.supportingEvidence.note && (
          <p class="mt-2 text-sm">{credential.supportingEvidence.note}</p>
        )}
        {credential.supportingEvidence.status !== "current" && (
          <p class="mt-2 text-sm">
            This external evidence record needs attention, but it does not
            change who issued the directory credential.
          </p>
        )}
      </div>
    )
  }
  <p class="mt-3 text-sm">{TIER_STANDARDS_CAVEAT}</p>
</div>
