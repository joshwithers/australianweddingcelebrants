---
import StaticDirectoryListings from './StaticDirectoryListings.astro';
import { getSinglePage } from "@/lib/contentParser.astro";

interface Props {
  sortBy?: 'alphabetical' | 'random';
  featuredOnly?: boolean;
  showFilters?: boolean;
  title?: string;
  maxItems?: number;
  premiumTiers?: Array<'luminary' | 'endorsed'>;
}

const {
  sortBy = 'alphabetical',
  featuredOnly = false,
  showFilters = true,
  title,
  maxItems,
  premiumTiers
} = Astro.props;

// Get all directory entries. StaticDirectoryListings does the shuffling and
// sorting; this component only supplies the data.
const directoryItems = await getSinglePage("directory");

// Note: there is deliberately no `?location=` handling here. The site builds to
// static HTML, so Astro.url.searchParams is always empty at build time —
// location filtering lives on the prerendered /directory/location/<slug>/
// routes instead.
---

<StaticDirectoryListings
  items={directoryItems}
  sortBy={sortBy}
  featuredOnly={featuredOnly}
  showFilters={showFilters}
  title={title}
  maxItems={maxItems}
  premiumTiers={premiumTiers}
/>
