---
import Base from "@/layouts/Base.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { humanize, markdownify, slugify } from "@/lib/utils/textConverter";
import { outputImageFormat } from "@/lib/utils/images";
import { Image } from "astro:assets";
import { render } from "astro:content";
import TierIcon from "@/components/TierIcon.astro";
import ProfileContactDetails from "@/components/ProfileContactDetails.astro";
import ProfileSocialLinks from "@/components/ProfileSocialLinks.astro";
import ProfileVideo from "@/components/ProfileVideo.astro";
import ProfileGallery from "@/components/ProfileGallery.astro";
import ProfileTestimonials from "@/components/ProfileTestimonials.astro";
import ProfileAwards from "@/components/ProfileAwards.astro";
import { deriveAwards } from "@/lib/utils/awards";
import { shuffled } from "@/lib/utils/shuffle";
import { serializeJsonLd } from "@/lib/utils/jsonLd";
import {
  absoluteUrl,
  australianPostalAddress,
  normalizeTelephone,
} from "@/lib/utils/profile";

export async function getStaticPaths() {
  const directoryEntries = await getSinglePage("directory");

  return directoryEntries.map((entry) => {
    const slug = entry.id || slugify(entry.data?.title || "vendor");
    return {
      params: { single: slug },
      props: { entry },
    };
  });
}

const { entry } = Astro.props;
const entrySlug = entry.id || slugify(entry.data?.title || "vendor");
const { Content } = await render(entry);
const tier = entry.data.tier || "registered";
const isPremium = tier === "endorsed" || tier === "luminary";
const websiteRel = isPremium ? "noopener" : "noopener nofollow noreferrer";

const withImagekitWidth = (url: string, width: number) => {
  if (!url.includes("imagekit.io")) return url;
  if (url.includes("?")) return url.replace(/\?tr=w-\d+/, `?tr=w-${width}`);
  return `${url}?tr=w-${width}`;
};

// Get same-tier celebrants (prefer same location, then same category)
const allVendors = await getSinglePage("directory");
const sameTierVendors = allVendors.filter(
  (vendor) =>
    vendor.id !== entry.id && (vendor.data.tier || "registered") === tier,
);

// Prioritise same location, then same category, then random
const relatedVendors = shuffled(sameTierVendors)
  .sort((a, b) => {
    const aLocMatch = a.data.location.some((loc) =>
      entry.data.location.includes(loc),
    )
      ? 1
      : 0;
    const bLocMatch = b.data.location.some((loc) =>
      entry.data.location.includes(loc),
    )
      ? 1
      : 0;
    if (aLocMatch !== bLocMatch) return bLocMatch - aLocMatch;
    const aCatMatch = a.data.category.some((cat) =>
      entry.data.category.includes(cat),
    )
      ? 1
      : 0;
    const bCatMatch = b.data.category.some((cat) =>
      entry.data.category.includes(cat),
    )
      ? 1
      : 0;
    if (aCatMatch !== bCatMatch) return bCatMatch - aCatMatch;
    return 0;
  })
  .slice(0, 3);

// Tier display info
const tierInfo = {
  registered: {
    label: "Registered Celebrant",
    color: "#6a6a6a",
    borderColor: "#e0e0e0",
    bg: "#f7f7f7",
    description:
      "This celebrant is a Commonwealth authorised marriage celebrant on the Attorney-General's register, holds a Certificate IV in Celebrancy or equivalent qualification, and has a verified professional profile. A Registered listing means you're working with a legally authorised, qualified celebrant who has provided their professional details for your review.",
    forCouples:
      "You can be confident this celebrant is legally authorised to solemnise marriages in Australia. Their profile has been verified and includes their professional photo, contact details, and service information.",
  },
  endorsed: {
    label: "Endorsed Celebrant",
    color: "#92174d",
    borderColor: "#92174d",
    bg: "#fdf2f7",
    description:
      "This celebrant has been recognised as an Endorsed Celebrant — meaning they've submitted documented proof of at least 3 years' experience, professional indemnity insurance, ongoing professional development beyond legislative requirements, 6 or more verified reviews from couples and 3 or more from fellow wedding vendors, and 100+ ceremonies performed.",
    forCouples:
      "An Endorsed celebrant has gone above and beyond the basics. They've proven their commitment to the profession through years of experience, over 100 ceremonies, verified client satisfaction, and continued investment in their craft. This isn't an award — it's a recognition of documented professionalism.",
  },
  luminary: {
    label: "Luminary Celebrant",
    color: "#460479",
    borderColor: "#460479",
    bg: "#f5f0fa",
    description:
      "This celebrant has achieved Luminary status — the highest recognition we offer. They've submitted documented proof of at least 7 years' experience, 18+ verified reviews from couples they've married, 9+ reviews from fellow wedding vendors, industry recognition through awards or media features, a demonstrated pattern of contribution to the celebrant profession, and a professional digital presence — their own up-to-date website, swift responses to enquiries, and a business email address on their own domain.",
    forCouples:
      "A Luminary celebrant represents the very best in the profession — endorsed by both clients and industry. They've not only built an exceptional track record with 18+ verified couple reviews and 9+ vendor reviews, but have also made a measurable impact on the industry through awards, mentoring, or community contribution. They run a professional operation: their own website is current, their email uses their own domain, and they reply to enquiries promptly. This recognition celebrates their outstanding commitment to excellence.",
  },
};

const currentTierInfo = tierInfo[tier] || tierInfo.registered;

// Tier credential mapping for structured data
const tierCredentials = {
  registered: {
    name: "Registered Celebrant",
    description:
      "Commonwealth authorised marriage celebrant with a Certificate IV in Celebrancy or equivalent qualification and a verified professional profile",
  },
  endorsed: {
    name: "Endorsed Celebrant",
    description:
      "Recognised for 3+ years experience, professional indemnity insurance, ongoing professional development, 6+ verified reviews from couples and 3+ from fellow wedding vendors, and 100+ ceremonies performed",
  },
  luminary: {
    name: "Luminary Celebrant",
    description:
      "Highest recognition for 7+ years experience, 18+ verified reviews from couples and 9+ from fellow wedding vendors, industry awards, demonstrated contribution to the profession, and a professional digital presence including an up-to-date own-domain website and business email",
  },
};

const currentCredential = tierCredentials[tier] || tierCredentials.registered;

// Prepare schema.org structured data
const siteUrl = "https://australianweddingcelebrants.com.au";
const imageUrl =
  typeof entry.data.image === "string"
    ? entry.data.image
    : entry.data.image?.src;

const businessUrl = `${siteUrl}/directory/${entry.id}/`;
const personId = `${businessUrl}#person`;
const sameAs = [
  entry.data.website,
  entry.data.social?.facebook,
  entry.data.social?.instagram,
  entry.data.social?.pinterest,
].filter(Boolean);

// Awards for both the visible Trophy Shelf and the schema.org `award` property.
const shelfAwards = deriveAwards(entry.data);
const awardStrings = shelfAwards.map((a) => {
  const parts = [a.emoji, a.title].filter(Boolean).join(" ").trim();
  const suffix = [a.region, a.year].filter(Boolean).join(", ");
  return suffix ? `${parts} (${suffix})` : parts;
});

const profileSchema = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": `${businessUrl}#profile`,
  url: businessUrl,
  name: entry.data.meta_title || entry.data.title,
  description: entry.data.description || "",
  mainEntity: {
    "@type": "Person",
    "@id": personId,
    name: entry.data.title,
    jobTitle: "Wedding Celebrant",
    url: businessUrl,
    description: entry.data.description || "",
    telephone: normalizeTelephone(entry.data.phone),
    email: entry.data.email || undefined,
    image: absoluteUrl(imageUrl, siteUrl),
    homeLocation: entry.data.address
      ? {
          "@type": "Place",
          name: entry.data.address,
          address: australianPostalAddress(entry.data.address),
        }
      : undefined,
    sameAs: sameAs,
    award: awardStrings.length > 0 ? awardStrings : undefined,
    makesOffer: {
      "@type": "Offer",
      itemOffered: {
        "@type": "Service",
        serviceType: "Wedding Celebrant",
        name: "Wedding Ceremony Services",
        areaServed: entry.data.location.map((loc) => ({
          "@type": "AdministrativeArea",
          name: humanize(loc),
        })),
      },
    },
    hasCredential: {
      "@type": "EducationalOccupationalCredential",
      credentialCategory: "professional-recognition",
      name: currentCredential.name,
      description: currentCredential.description,
      recognizedBy: {
        "@type": "Organization",
        name: "Australian Wedding Celebrants",
        url: siteUrl,
      },
    },
    knowsAbout: ["Wedding Ceremony", "Marriage Celebrancy", "Civil Marriage"],
  },
};

// BreadcrumbList schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: siteUrl },
    {
      "@type": "ListItem",
      position: 2,
      name: "Directory",
      item: `${siteUrl}/directory/`,
    },
    { "@type": "ListItem", position: 3, name: entry.data.title },
  ],
};

// Luminary-only custom page background (hex colour).
const pageBg = tier === "luminary" ? entry.data.background_color : undefined;
const logoFrameStyle =
  entry.data.logo && typeof entry.data.logo !== "string"
    ? `width: min(100%, calc(12rem * ${entry.data.logo.width / entry.data.logo.height})); aspect-ratio: ${entry.data.logo.width} / ${entry.data.logo.height};`
    : undefined;
---

<Base
  title={entry.data.title}
  meta_title={entry.data.meta_title}
  description={entry.data.description}
  image={typeof entry.data.image === "string"
    ? entry.data.image
    : entry.data.image?.src}
  canonical={businessUrl}
  og_type="profile"
  page_bg={pageBg}
>
  <script
    is:inline
    type="application/ld+json"
    set:html={serializeJsonLd(profileSchema)}
  />
  <script
    is:inline
    type="application/ld+json"
    set:html={serializeJsonLd(breadcrumbSchema)}
  />

  <section
    class="py-12 md:py-16"
    style={pageBg ? `background-color: ${pageBg};` : undefined}
  >
    <div class="container">
      {/* Breadcrumb */}
      <nav class="mb-8">
        <ol
          class="text-light flex items-center gap-2 text-sm"
          style="font-weight: 400;"
        >
          <li><a href="/" class="hover:text-dark no-underline">Home</a></li>
          <li class="text-border">/</li>
          <li>
            <a href="/directory/" class="hover:text-dark no-underline"
              >Directory</a
            >
          </li>
          <li class="text-border">/</li>
          <li class="text-dark" style="font-weight: 500;">
            {entry.data.title}
          </li>
        </ol>
      </nav>

      {
        tier === "luminary" ? (
          <div class="luminary-hero mx-auto max-w-4xl text-center">
            {entry.data.logo ? (
              <>
                <h1 class="sr-only" set:html={markdownify(entry.data.title)} />
                <div class="mb-6 flex justify-center">
                  <div class="profile-logo-frame" style={logoFrameStyle}>
                    {typeof entry.data.logo === "string" ? (
                      <img
                        src={entry.data.logo}
                        alt={entry.data.title}
                        class="h-auto max-h-48 w-auto max-w-full"
                        loading="eager"
                      />
                    ) : (
                      <Image
                        src={entry.data.logo}
                        alt={entry.data.title}
                        width={800}
                        class="h-auto max-h-48 w-auto max-w-full"
                        loading="eager"
                        format={outputImageFormat(entry.data.logo)}
                      />
                    )}
                  </div>
                </div>
              </>
            ) : (
              <h1
                class="mb-6"
                style="font-weight: 700; letter-spacing: -0.44px; line-height: 1.2;"
                set:html={markdownify(entry.data.title)}
              />
            )}

            {entry.data.image && (
              <div class="luminary-hero__photo mx-auto mb-8">
                {typeof entry.data.image === "string" ? (
                  <img
                    src={withImagekitWidth(entry.data.image, 1200)}
                    alt={entry.data.title}
                    loading="eager"
                  />
                ) : (
                  <Image
                    src={entry.data.image}
                    alt={entry.data.title}
                    widths={[360, 480, 600, 720, 1080]}
                    sizes="(min-width: 1024px) 680px, (min-width: 768px) 560px, calc(90vw - 2.5rem)"
                    loading="eager"
                    decoding="async"
                    fetchpriority="high"
                    quality={65}
                    format={outputImageFormat(entry.data.image)}
                  />
                )}
              </div>
            )}

            <div class="mb-6 flex flex-wrap justify-center gap-2">
              <a
                href="/luminaries/"
                class="pill-luminary inline-flex items-center gap-2 rounded-full px-3 py-1 text-sm no-underline transition-all"
                style="font-weight: 600;"
              >
                <TierIcon tier="luminary" size={14} />
                Luminary Celebrant
              </a>
              {entry.data.australia_wide && (
                <a
                  href="/australia-wide/"
                  class="pill-dark inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-sm no-underline transition-all"
                  style="font-weight: 500;"
                >
                  <svg
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <circle cx="12" cy="12" r="10" />
                    <path d="M2 12h20" />
                    <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
                  </svg>
                  Travels Australia Wide
                </a>
              )}
              {entry.data.international && (
                <a
                  href="/destination-wedding-celebrants/"
                  class="pill-dark inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-sm no-underline transition-all"
                  style="font-weight: 500;"
                >
                  <svg
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M21.54 15H17a2 2 0 0 0-2 2v4.54" />
                    <path d="M7 3.34V5a3 3 0 0 0 3 3a2 2 0 0 1 2 2c0 1.1.9 2 2 2a2 2 0 0 0 2-2c0-1.1.9-2 2-2h3.17" />
                    <path d="M11 21.95V18a2 2 0 0 0-2-2a2 2 0 0 1-2-2v-1a2 2 0 0 0-2-2H2.05" />
                    <circle cx="12" cy="12" r="10" />
                  </svg>
                  Destination Weddings
                </a>
              )}
            </div>

            {entry.data.description && (
              <p
                class="text-light mx-auto mb-8 max-w-2xl text-lg"
                style="font-weight: 400; line-height: 1.6;"
              >
                {entry.data.description}
              </p>
            )}

            <div class="mb-6">
              <ProfileContactDetails
                location={entry.data.location}
                website={entry.data.website}
                email={entry.data.email}
                phone={entry.data.phone}
                address={entry.data.address}
                tier={tier}
                centered
              />
            </div>

            {entry.data.social && (
              <div class="mb-6 flex justify-center">
                <ProfileSocialLinks
                  facebook={entry.data.social.facebook}
                  instagram={entry.data.social.instagram}
                  pinterest={entry.data.social.pinterest}
                />
              </div>
            )}

            <div class="flex flex-wrap justify-center gap-3">
              {entry.data.website && (
                <a
                  href={entry.data.website}
                  target="_blank"
                  rel={websiteRel}
                  class="btn btn-primary no-underline"
                >
                  Visit Website
                </a>
              )}
              {entry.data.email && (
                <a
                  href={`mailto:${entry.data.email}`}
                  class="btn btn-outline-primary no-underline"
                >
                  Get in Touch
                </a>
              )}
            </div>
          </div>
        ) : (
          <div class="flex flex-wrap items-start gap-10">
            {entry.data.image && (
              <div class="w-full md:w-[calc(50%-1.25rem)] lg:w-[calc(60%-1.25rem)]">
                <div
                  class="rounded-card overflow-hidden"
                  style="box-shadow: rgba(0,0,0,0.02) 0px 0px 0px 1px, rgba(0,0,0,0.04) 0px 2px 6px, rgba(0,0,0,0.1) 0px 4px 8px;"
                >
                  {typeof entry.data.image === "string" ? (
                    <img
                      src={withImagekitWidth(entry.data.image, 600)}
                      alt={entry.data.title}
                      width={600}
                      height={600}
                      class="profile-hero-img w-full"
                      loading="eager"
                    />
                  ) : (
                    <Image
                      src={entry.data.image}
                      alt={entry.data.title}
                      width={600}
                      height={600}
                      class="profile-hero-img w-full"
                      loading="eager"
                      format={outputImageFormat(entry.data.image)}
                    />
                  )}
                </div>
              </div>
            )}

            <div
              class={
                entry.data.image ? "min-w-0 flex-1" : "mx-auto w-full max-w-2xl"
              }
            >
              <div class="mb-6">
                {entry.data.logo && isPremium ? (
                  <div class="mb-4">
                    <div class="profile-logo-frame" style={logoFrameStyle}>
                      {typeof entry.data.logo === "string" ? (
                        <img
                          src={entry.data.logo}
                          alt={entry.data.title}
                          class="h-auto max-h-48 w-auto max-w-full"
                          loading="eager"
                        />
                      ) : (
                        <Image
                          src={entry.data.logo}
                          alt={entry.data.title}
                          width={800}
                          class="h-auto max-h-48 w-auto max-w-full"
                          loading="eager"
                          format={outputImageFormat(entry.data.logo)}
                        />
                      )}
                    </div>
                  </div>
                ) : (
                  <h1
                    style="font-weight: 700; letter-spacing: -0.44px; line-height: 1.2;"
                    set:html={markdownify(entry.data.title)}
                  />
                )}

                <div class="mt-3 flex flex-wrap gap-2">
                  {tier === "endorsed" && (
                    <a
                      href="/endorsed/"
                      class="pill-endorsed inline-flex items-center gap-2 rounded-full px-3 py-1 text-sm no-underline transition-all"
                      style="font-weight: 600;"
                    >
                      <TierIcon tier="endorsed" size={14} />
                      Endorsed Celebrant
                    </a>
                  )}
                  {tier === "registered" && (
                    <a
                      href="/registered/"
                      class="text-light border-border hover:bg-theme-light hover:text-dark inline-flex items-center gap-2 rounded-full border px-3 py-1 text-sm no-underline transition-all"
                      style="font-weight: 500;"
                    >
                      Registered Celebrant
                    </a>
                  )}
                  {entry.data.australia_wide && (
                    <a
                      href="/australia-wide/"
                      class="pill-dark inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-sm no-underline transition-all"
                      style="font-weight: 500;"
                    >
                      <svg
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <circle cx="12" cy="12" r="10" />
                        <path d="M2 12h20" />
                        <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
                      </svg>
                      Travels Australia Wide
                    </a>
                  )}
                  {entry.data.international && (
                    <a
                      href="/destination-wedding-celebrants/"
                      class="pill-dark inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-sm no-underline transition-all"
                      style="font-weight: 500;"
                    >
                      <svg
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d="M21.54 15H17a2 2 0 0 0-2 2v4.54" />
                        <path d="M7 3.34V5a3 3 0 0 0 3 3a2 2 0 0 1 2 2c0 1.1.9 2 2 2a2 2 0 0 0 2-2c0-1.1.9-2 2-2h3.17" />
                        <path d="M11 21.95V18a2 2 0 0 0-2-2a2 2 0 0 1-2-2v-1a2 2 0 0 0-2-2H2.05" />
                        <circle cx="12" cy="12" r="10" />
                      </svg>
                      Destination Weddings
                    </a>
                  )}
                </div>

                {entry.data.description && (
                  <p
                    class="text-light mt-4 text-base"
                    style="font-weight: 400; line-height: 1.6;"
                  >
                    {entry.data.description}
                  </p>
                )}
              </div>

              <div class="mb-6">
                <ProfileContactDetails
                  location={entry.data.location}
                  website={entry.data.website}
                  email={entry.data.email}
                  phone={entry.data.phone}
                  address={entry.data.address}
                />
              </div>

              {entry.data.social && (
                <div class="mt-6">
                  <ProfileSocialLinks
                    facebook={entry.data.social.facebook}
                    instagram={entry.data.social.instagram}
                    pinterest={entry.data.social.pinterest}
                  />
                </div>
              )}

              <div class="mt-8 flex flex-wrap gap-3">
                {entry.data.website && (
                  <a
                    href={entry.data.website}
                    target="_blank"
                    rel={websiteRel}
                    class="btn btn-primary no-underline"
                  >
                    Visit Website
                  </a>
                )}
                {entry.data.email && (
                  <a
                    href={`mailto:${entry.data.email}`}
                    class="btn btn-outline-primary no-underline"
                  >
                    Get in Touch
                  </a>
                )}
              </div>
            </div>
          </div>
        )
      }

      {/* Content body */}
      {
        entry.body && (
          <div class="content border-border mx-auto mt-16 max-w-3xl border-t pt-12">
            {entry.data.logo && tier === "endorsed" && (
              <h1
                class="mb-6"
                style="font-weight: 700; letter-spacing: -0.44px; line-height: 1.2;"
                set:html={markdownify(entry.data.title)}
              />
            )}
            <Content />
          </div>
        )
      }

      {/* YouTube feature video */}
      {
        entry.data.youtube && (
          <div class="mx-auto mt-16 max-w-4xl">
            <ProfileVideo
              url={entry.data.youtube}
              title={`Meet ${entry.data.title}`}
            />
          </div>
        )
      }

      {/* Gallery */}
      {
        entry.data.gallery && entry.data.gallery.length > 0 && (
          <div class="mx-auto mt-12 max-w-5xl">
            <ProfileGallery
              images={entry.data.gallery}
              alt={`Work by ${entry.data.title}`}
            />
          </div>
        )
      }

      {/* Luminary + Endorsed: testimonials */}
      {
        (tier === "luminary" || tier === "endorsed") &&
          entry.data.testimonials &&
          entry.data.testimonials.length > 0 && (
            <div class="mx-auto mt-16 max-w-5xl">
              <ProfileTestimonials
                testimonials={entry.data.testimonials}
                subjectName={entry.data.title}
              />
            </div>
          )
      }

      {/* Awards — trophy shelf of regional + fun recognitions */}
      {
        shelfAwards.length > 0 && (
          <div class="mx-auto mt-16 max-w-5xl">
            <ProfileAwards
              awards={shelfAwards}
              subjectName={entry.data.title}
              subjectSlug={entrySlug}
            />
          </div>
        )
      }

      {/* Tier info box */}
      <div class="mt-20 pt-12">
        <div
          class="rounded-card p-8 md:p-10"
          style={`border: 2px solid ${currentTierInfo.borderColor}; background: ${currentTierInfo.bg};`}
        >
          <div class="flex flex-col gap-6 md:flex-row md:items-start">
            <div class="flex-none">
              {
                tier === "luminary" && (
                  <div
                    class="inline-flex items-center gap-2 rounded-full px-4 py-1.5 text-sm text-white"
                    style="font-weight: 600; background: #460479;"
                  >
                    <svg
                      width="14"
                      height="14"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                    >
                      <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" />
                    </svg>
                    Luminary
                  </div>
                )
              }
              {
                tier === "endorsed" && (
                  <div
                    class="inline-flex items-center gap-2 rounded-full px-4 py-1.5 text-sm text-white"
                    style="font-weight: 600; background: #92174d;"
                  >
                    <svg
                      width="14"
                      height="14"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                    >
                      <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z" />
                    </svg>
                    Endorsed
                  </div>
                )
              }
              {
                tier === "registered" && (
                  <div
                    class="text-light border-border inline-flex items-center gap-2 rounded-full border px-4 py-1.5 text-sm"
                    style="font-weight: 500;"
                  >
                    Registered
                  </div>
                )
              }
            </div>
            <div>
              <h2
                class="text-dark mb-2 text-base"
                style="font-weight: 600; letter-spacing: -0.18px;"
              >
                What does {currentTierInfo.label} mean for you?
              </h2>
              <p
                class="text-dark mb-3 text-sm"
                style="font-weight: 400; line-height: 1.6;"
              >
                {currentTierInfo.forCouples}
              </p>
              <a
                href="/tiers/"
                class="text-sm no-underline hover:underline"
                style={`color: ${currentTierInfo.color}; font-weight: 500;`}
              >
                Learn more about our standards
              </a>
            </div>
          </div>
        </div>
      </div>

      {/* Celebrant tools — embed badge + edit listing (for profile owners) */}
      <div class="mt-16 pt-12">
        <details class="group">
          <summary
            class="text-light hover:text-dark flex cursor-pointer list-none items-center gap-3 text-sm transition-colors duration-200"
            style="font-weight: 500;"
