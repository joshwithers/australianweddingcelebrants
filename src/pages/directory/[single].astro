            <svg
              class="h-5 w-5 transition-transform duration-200 group-open:rotate-90"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
              ><path
                d="M9 18l6-6-6-6"
                stroke-linecap="round"
                stroke-linejoin="round"></path></svg
            >
            Is this your listing? Edit it or grab your badge
          </summary>
          <div class="mt-6 space-y-6">
            {/* Edit listing */}
            <div class="flex items-start gap-4">
              <svg
                class="text-light mt-0.5 h-5 w-5 flex-none"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                aria-hidden="true"
                ><path d="M12 20h9" stroke-linecap="round"></path><path
                  d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path></svg
              >
              <div class="flex-1">
                <h3 class="text-dark mb-1 text-sm" style="font-weight: 600;">
                  Manage your profile
                </h3>
                <p
                  class="text-light mb-2 text-sm"
                  style="font-weight: 400; line-height: 1.6;"
                >
                  Sign in to update your photos, bio, contact details and more.
                </p>
                <a
                  href={`https://api.australianweddingcelebrants.com.au/login?slug=${entrySlug}`}
                  class="text-dark hover:text-primary text-sm no-underline hover:underline"
                  style="font-weight: 500;"
                >
                  Edit this listing →
                </a>
              </div>
            </div>

            <div class="border-border border-t"></div>

            <h3 class="text-dark text-sm" style="font-weight: 600;">
              Embed your tier badge
            </h3>
            <p
              class="text-light text-sm"
              style="font-weight: 400; line-height: 1.6;"
            >
              Copy this code and paste it into your website to display your
              Australian Wedding Celebrants tier badge.
            </p>

            {/* Badge preview */}
            <div class="bg-theme-light rounded-card flex justify-center p-6">
              <div
                style={`display:inline-flex;align-items:center;gap:8px;padding:10px 20px;border-radius:50px;font-family:Inter,-apple-system,system-ui,sans-serif;font-size:13px;font-weight:600;text-decoration:none;transition:opacity 0.2s;${
                  tier === "luminary"
                    ? "background:#460479;color:#fff;"
                    : tier === "endorsed"
                      ? "background:#92174d;color:#fff;"
                      : "background:#f7f7f7;color:#6a6a6a;border:1px solid #e0e0e0;"
                }`}
              >
                {
                  tier === "luminary" && (
                    <svg
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                    >
                      <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" />
                    </svg>
                  )
                }
                {
                  tier === "endorsed" && (
                    <svg
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                    >
                      <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z" />
                    </svg>
                  )
                }
                {currentTierInfo.label}
              </div>
            </div>

            {/* Code block */}
            <div class="relative">
              <pre
                class="bg-dark rounded-card overflow-x-auto p-5 text-xs text-white"
                style="line-height: 1.6;"><code id="embedCode" set:html={
                tier === "luminary"
                  ? `&lt;a href=&quot;https://australianweddingcelebrants.com.au/directory/${entrySlug}/&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot; style=&quot;display:inline-flex;align-items:center;gap:8px;padding:10px 20px;border-radius:50px;background:#460479;color:#fff;font-family:Inter,-apple-system,system-ui,sans-serif;font-size:13px;font-weight:600;text-decoration:none;transition:opacity 0.2s;&quot; onmouseover=&quot;this.style.opacity='0.85'&quot; onmouseout=&quot;this.style.opacity='1'&quot;&gt;&lt;svg width=&quot;16&quot; height=&quot;16&quot; viewBox=&quot;0 0 24 24&quot; fill=&quot;currentColor&quot;&gt;&lt;path d=&quot;M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z&quot;/&gt;&lt;/svg&gt;Luminary Celebrant&lt;/a&gt;`
                  : tier === "endorsed"
                  ? `&lt;a href=&quot;https://australianweddingcelebrants.com.au/directory/${entrySlug}/&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot; style=&quot;display:inline-flex;align-items:center;gap:8px;padding:10px 20px;border-radius:50px;background:#92174d;color:#fff;font-family:Inter,-apple-system,system-ui,sans-serif;font-size:13px;font-weight:600;text-decoration:none;transition:opacity 0.2s;&quot; onmouseover=&quot;this.style.opacity='0.85'&quot; onmouseout=&quot;this.style.opacity='1'&quot;&gt;&lt;svg width=&quot;16&quot; height=&quot;16&quot; viewBox=&quot;0 0 24 24&quot; fill=&quot;currentColor&quot;&gt;&lt;path d=&quot;M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z&quot;/&gt;&lt;/svg&gt;Endorsed Celebrant&lt;/a&gt;`
                  : `&lt;a href=&quot;https://australianweddingcelebrants.com.au/directory/${entrySlug}/&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot; style=&quot;display:inline-flex;align-items:center;gap:8px;padding:10px 20px;border-radius:50px;background:#f7f7f7;color:#6a6a6a;border:1px solid #e0e0e0;font-family:Inter,-apple-system,system-ui,sans-serif;font-size:13px;font-weight:600;text-decoration:none;transition:opacity 0.2s;&quot; onmouseover=&quot;this.style.opacity='0.85'&quot; onmouseout=&quot;this.style.opacity='1'&quot;&gt;Registered Celebrant&lt;/a&gt;`
              } /></pre>
              <button
                id="copyBtn"
                class="rounded-btn absolute top-3 right-3 bg-white/10 px-3 py-1.5 text-xs text-white/70 transition-all duration-200 hover:bg-white/20 hover:text-white"
                style="font-weight: 500;"
                type="button"
              >
                Copy
              </button>
            </div>
          </div>
        </details>
      </div>

      {/* Same-tier celebrants */}
      {
        relatedVendors.length > 0 && (
          <div class="border-border mt-16 border-t pt-12">
            <h2
              class="mb-10"
              style="font-weight: 600; letter-spacing: -0.44px;"
            >
              More {currentTierInfo.label}s
            </h2>
            <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
              {relatedVendors.map((vendor) => {
                const vendorTier = vendor.data.tier || "registered";
                const vendorSlug =
                  vendor.id || slugify(vendor.data?.title || "vendor");
                return (
                  <div>
                    <a
                      href={`/directory/${vendorSlug}/`}
                      class="group block no-underline"
                    >
                      <div
                        class="rounded-card hover:shadow-card-hover overflow-hidden bg-white transition-shadow duration-300"
                        style="box-shadow: rgba(0,0,0,0.02) 0px 0px 0px 1px, rgba(0,0,0,0.04) 0px 2px 6px, rgba(0,0,0,0.1) 0px 4px 8px;"
                      >
                        {vendor.data.image && (
                          <div class="relative overflow-hidden">
                            {typeof vendor.data.image === "string" ? (
                              <img
                                src={withImagekitWidth(vendor.data.image, 400)}
                                alt={vendor.data.title}
                                loading="lazy"
                                class="related-card-img w-full transition-transform duration-500 group-hover:scale-[1.03]"
                              />
                            ) : (
                              <Image
                                src={vendor.data.image}
                                alt={vendor.data.title}
                                width={400}
                                loading="lazy"
                                class="related-card-img w-full transition-transform duration-500 group-hover:scale-[1.03]"
                                format={outputImageFormat(vendor.data.image)}
                              />
                            )}
                            {vendorTier === "luminary" && (
                              <span
                                class="rounded-badge absolute top-3 left-3 flex items-center gap-1.5 px-3 py-1 text-xs text-white"
                                style="font-weight: 600; background: #460479; backdrop-filter: blur(4px);"
                              >
                                <svg
                                  width="12"
                                  height="12"
                                  viewBox="0 0 24 24"
                                  fill="currentColor"
                                >
                                  <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" />
                                </svg>
                                Luminary
                              </span>
                            )}
                            {vendorTier === "endorsed" && (
                              <span
                                class="rounded-badge absolute top-3 left-3 flex items-center gap-1.5 px-3 py-1 text-xs text-white"
                                style="font-weight: 600; background: #92174d; backdrop-filter: blur(4px);"
                              >
                                <svg
                                  width="12"
                                  height="12"
                                  viewBox="0 0 24 24"
                                  fill="currentColor"
                                >
                                  <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z" />
                                </svg>
                                Endorsed
                              </span>
                            )}
                            {vendorTier === "registered" && (
                              <span
                                class="rounded-badge absolute top-3 left-3 px-3 py-1 text-xs"
                                style="font-weight: 500; background: rgba(255,255,255,0.9); color: #6a6a6a; backdrop-filter: blur(4px);"
                              >
                                Registered
                              </span>
                            )}
                          </div>
                        )}
                        <div class="p-4">
                          <h3
                            class="text-dark mb-1 text-base"
                            style="font-weight: 600; letter-spacing: -0.18px;"
                          >
                            {vendor.data.title}
                          </h3>
                          {vendor.data.location &&
                            vendor.data.location.length > 0 && (
                              <p
                                class="text-light mb-1 text-sm"
                                style="font-weight: 400;"
                              >
                                {vendor.data.location
                                  .map((loc) => humanize(loc))
                                  .join(" · ")}
                              </p>
                            )}
                          {vendor.data.description && (
                            <p
                              class="text-light mb-3 line-clamp-2 text-sm"
                              style="font-weight: 400;"
                            >
                              {vendor.data.description}
                            </p>
                          )}
                          <div class="flex flex-wrap gap-1.5">
                            {vendor.data.category.map((cat) => (
                              <span
                                class="bg-theme-light text-dark rounded-badge px-2 py-0.5 text-xs"
                                style="font-weight: 500;"
                              >
                                {humanize(cat)}
                              </span>
                            ))}
                            {vendor.data.australia_wide && (
                              <span
                                class="rounded-badge flex items-center gap-1 px-2 py-0.5 text-xs text-white"
                                style="font-weight: 500; background: #222;"
                              >
                                <svg
                                  width="10"
                                  height="10"
                                  viewBox="0 0 24 24"
                                  fill="none"
                                  stroke="currentColor"
                                  stroke-width="2.5"
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                                >
                                  <circle cx="12" cy="12" r="10" />
                                  <path d="M2 12h20" />
                                  <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
                                </svg>
                                Australia Wide
                              </span>
                            )}
                            {vendor.data.international && (
                              <span
                                class="rounded-badge flex items-center gap-1 px-2 py-0.5 text-xs text-white"
                                style="font-weight: 500; background: #222;"
                              >
                                <svg
                                  width="10"
                                  height="10"
                                  viewBox="0 0 24 24"
                                  fill="none"
                                  stroke="currentColor"
                                  stroke-width="2.5"
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                                >
                                  <path d="M21.54 15H17a2 2 0 0 0-2 2v4.54" />
                                  <path d="M7 3.34V5a3 3 0 0 0 3 3a2 2 0 0 1 2 2c0 1.1.9 2 2 2a2 2 0 0 0 2-2c0-1.1.9-2 2-2h3.17" />
                                  <path d="M11 21.95V18a2 2 0 0 0-2-2a2 2 0 0 1-2-2v-1a2 2 0 0 0-2-2H2.05" />
                                  <circle cx="12" cy="12" r="10" />
                                </svg>
                                Destination
                              </span>
                            )}
                          </div>
                        </div>
                      </div>
                    </a>
                  </div>
                );
              })}
            </div>
          </div>
        )
      }

      {/* Back to directory */}
      <div class="mt-16 text-center">
        <a href="/directory/" class="btn btn-outline-primary no-underline"
          >Back to Directory</a
        >
      </div>
    </div>
  </section>

  <script>
    document.addEventListener("click", async (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const button = target.closest<HTMLButtonElement>("#copyBtn");
      if (!button) return;

      const text = document.getElementById("embedCode")?.textContent?.trim();
      if (!text || !navigator.clipboard) {
        button.textContent = "Copy failed";
        return;
      }

      try {
        await navigator.clipboard.writeText(text);
        button.textContent = "Copied!";
        window.setTimeout(() => {
          if (button.isConnected) button.textContent = "Copy";
        }, 2000);
      } catch {
        button.textContent = "Copy failed";
      }
    });
  </script>
</Base>

