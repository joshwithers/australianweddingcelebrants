---
import Base from "@/layouts/Base.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { markdownify, slugify } from "@/lib/utils/textConverter";
import { serializeJsonLd } from "@/lib/utils/jsonLd";
import {
  absoluteUrl,
  australianPostalAddress,
  normalizeTelephone,
} from "@/lib/utils/profile";
import { getEntry, render } from "astro:content";
import DirectoryListingsWrapper from "../../components/DirectoryListingsWrapper.astro";
import TierIcon from "@/components/TierIcon.astro";
import { PUBLISHER } from "@/lib/siteProvenance";

// Get all directory entries
const directoryItems = await getSinglePage("directory");

// Stable, non-commercial order for machine-readable directory data.
// Placement is based on the published recognition tier, then alphabetically.
const tierOrder = { luminary: 0, endorsed: 1, registered: 2 };
const sortedItems = [...directoryItems].sort((a, b) => {
  const tierDifference =
    (tierOrder[a.data.tier || "registered"] ?? 2) -
    (tierOrder[b.data.tier || "registered"] ?? 2);
  return tierDifference || a.data.title.localeCompare(b.data.title);
});

// Get all unique locations
const allLocations = [
  ...new Set(sortedItems.flatMap((entry) => entry.data.location)),
].sort();

// Get page data
const pageEntry = await getEntry("pages", "directory");
if (!pageEntry) {
  throw new Error("Directory page entry not found");
}
const { Content } = await render(pageEntry);
---

<Base title={pageEntry.data.title}>
  <script
    is:inline
    type="application/ld+json"
    set:html={serializeJsonLd({
      "@context": "https://schema.org",
      "@type": "ItemList",
      name: "Australian Wedding Celebrants Directory",
      description:
        "Australian wedding celebrant profiles with Registered, Endorsed, and Luminary credentials issued and human verified by Australian Wedding Celebrants.",
      publisher: {
        "@type": "Organization",
        "@id": PUBLISHER.id,
        name: PUBLISHER.name,
        url: PUBLISHER.url,
      },
      numberOfItems: sortedItems.length,
      itemListElement: sortedItems.map((entry, i) => ({
        "@type": "ListItem",
        position: i + 1,
        item: {
          "@type": "Person",
          "@id": `https://australianweddingcelebrants.com.au/directory/${entry.id}/#person`,
          name: entry.data.title,
          url: `https://australianweddingcelebrants.com.au/directory/${entry.id}/`,
          description: `${entry.data.title} member profile with a credential issued and human verified by Australian Wedding Celebrants.`,
          image: absoluteUrl(
            typeof entry.data.image === "string"
              ? entry.data.image
              : entry.data.image?.src,
            "https://australianweddingcelebrants.com.au",
          ),
          telephone: normalizeTelephone(entry.data.phone),
          homeLocation: entry.data.address
            ? {
                "@type": "Place",
                name: entry.data.address,
                address: australianPostalAddress(entry.data.address),
              }
            : undefined,
        },
      })),
    })}
  />
  <section class="py-16 md:py-20">
    <div class="container">
      {/* Page header */}
      <div class="mb-12 text-center">
        <h1
          class="mb-4"
          style="font-weight: 700; letter-spacing: -0.44px;"
          set:html={markdownify(pageEntry.data.title)}
        />
        <div class="text-light mx-auto max-w-2xl">
          <Content />
        </div>
      </div>

      {/* Browse by type */}
      <div class="mb-12 flex flex-wrap justify-center gap-3">
        <a
          href="/luminaries/"
          class="pill-luminary hover:shadow-hover inline-flex items-center gap-1.5 rounded-full px-5 py-2.5 text-sm no-underline transition-all duration-200"
          style="font-weight: 600;"
        >
          <TierIcon tier="luminary" size={14} />
          Luminary Celebrants
        </a>
        <a
          href="/endorsed/"
          class="pill-endorsed hover:shadow-hover inline-flex items-center gap-1.5 rounded-full px-5 py-2.5 text-sm no-underline transition-all duration-200"
          style="font-weight: 600;"
        >
          <TierIcon tier="endorsed" size={14} />
          Endorsed Celebrants
        </a>
        <a
          href="/registered/"
          class="border-border text-dark hover:border-dark hover:bg-theme-light hover:shadow-hover inline-flex items-center gap-1.5 rounded-full border bg-white px-5 py-2.5 text-sm no-underline transition-all duration-200"
          style="font-weight: 500;"
        >
          Registered Celebrants
        </a>
        <a
          href="/australia-wide/"
          class="pill-dark hover:shadow-hover inline-flex items-center gap-1.5 rounded-full px-5 py-2.5 text-sm no-underline transition-all duration-200"
          style="font-weight: 500;"
        >
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><circle cx="12" cy="12" r="10"></circle><path d="M2 12h20"
            ></path><path
              d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
            ></path></svg
          >
          Australia Wide
        </a>
        <a
          href="/destination-wedding-celebrants/"
          class="pill-dark hover:shadow-hover inline-flex items-center gap-1.5 rounded-full px-5 py-2.5 text-sm no-underline transition-all duration-200"
          style="font-weight: 500;"
        >
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path d="M21.54 15H17a2 2 0 0 0-2 2v4.54"></path><path
              d="M7 3.34V5a3 3 0 0 0 3 3a2 2 0 0 1 2 2c0 1.1.9 2 2 2a2 2 0 0 0 2-2c0-1.1.9-2 2-2h3.17"
            ></path><path
              d="M11 21.95V18a2 2 0 0 0-2-2a2 2 0 0 1-2-2v-1a2 2 0 0 0-2-2H2.05"
            ></path><circle cx="12" cy="12" r="10"></circle></svg
          >
          Destination Weddings
        </a>
      </div>

      {/* Directory listings with filters */}
      <DirectoryListingsWrapper
        sortBy="random"
        featuredOnly={false}
        showFilters={true}
      />

      {/* Browse by location */}
      <div class="border-border mt-20 border-t pt-12">
        <h2
          class="mb-10 text-center"
          style="font-weight: 600; letter-spacing: -0.44px;"
        >
          Browse by Location
        </h2>
        <div class="flex flex-wrap justify-center gap-3">
          {
            allLocations.map((location) => (
              <a
                href={`/directory/location/${slugify(location)}/`}
                class="border-border text-dark hover:border-dark hover:shadow-hover inline-block rounded-full border bg-white px-5 py-2.5 text-sm no-underline transition-all duration-200"
                style="font-weight: 500;"
              >
                {location}
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</Base>
