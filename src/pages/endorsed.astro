---
import Base from "@/layouts/Base.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import MasonryGrid from "@/components/MasonryGrid.astro";

const allItems = await getSinglePage("directory");
const items = allItems.filter(
  (item) => (item.data.tier || "registered") === "endorsed",
);
// Fisher-Yates shuffle for fair random ordering
for (let i = items.length - 1; i > 0; i--) {
  const j = Math.floor(Math.random() * (i + 1));
  [items[i], items[j]] = [items[j], items[i]];
}
---

<Base
  title="Endorsed Celebrants"
  meta_title="Endorsed Celebrants — Australian Wedding Celebrants"
  description="Browse Endorsed credentials issued and human verified by Australian Wedding Celebrants against its published professional standard."
>
  <section class="py-12 md:py-16">
    <div class="container">
      <div class="mb-12 text-center">
        <div
          class="mb-4 inline-flex items-center gap-2 rounded-full px-4 py-1.5 text-sm text-white"
          style="font-weight: 600; background: #92174d;"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"
            ><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"
            ></path></svg
          >
          Endorsed
        </div>
        <h1
          class="mb-4"
          style="font-weight: 700; letter-spacing: -0.44px; line-height: 1.2;"
        >
          Endorsed Celebrants
        </h1>
        <p
          class="text-light mx-auto max-w-2xl"
          style="font-weight: 400; line-height: 1.6;"
        >
          These {items.length} profiles carry an Endorsed credential issued and human
          verified by Australian Wedding Celebrants. The published standard includes
          experience, insurance, professional development, reviews, and ceremony evidence.
          It is not a third-party endorsement or an availability promise.
        </p>
      </div>

      <MasonryGrid items={items} />

      {
        items.length === 0 && (
          <div class="py-16 text-center">
            <p class="text-light text-lg">
              No endorsed celebrants yet.{" "}
              <a href="/contact/" class="text-dark underline">
                Submit your documentation
              </a>{" "}
              to be the first.
            </p>
          </div>
        )
      }

      <div class="mt-12 text-center">
        <a href="/directory/" class="btn btn-outline-primary no-underline"
          >View All Celebrants</a
        >
      </div>
    </div>
  </section>
</Base>
