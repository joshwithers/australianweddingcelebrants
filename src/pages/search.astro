---
import Base from "@/layouts/Base.astro";
import SearchBar from "@/layouts/SearchBar.astro";
import { getSinglePage } from "@/lib/contentParser.astro";

const directory = await getSinglePage("directory");
---

<Base
  title="Search"
  meta_title="Search Australian Wedding Celebrants"
  description={`Search ${directory.length} celebrants by name, location, or specialty.`}
>
  <section class="py-16 md:py-20">
    <div class="container max-w-3xl">
      <div class="mb-10 text-center">
        <h1 style="font-weight: 700; letter-spacing: -0.44px;">Search</h1>
        <p class="text-light mt-3" style="font-weight: 400;">
          Find celebrants by name, location, or specialty — searching {
            directory.length
          } celebrants across Australia.
        </p>
      </div>
      <SearchBar searchList={directory} />
    </div>
  </section>
</Base>
