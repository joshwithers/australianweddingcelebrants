---
import Base from "@/layouts/Base.astro";
import EditorialByline from "@/components/EditorialByline.astro";
import { getEditorialArticle, resolveEditorialAuthor } from "@/lib/editorial";

const mcpUrl = "https://api.australianweddingcelebrants.com.au/mcp";
const article = getEditorialArticle("/connect/");
const articleAuthor = resolveEditorialAuthor(article.author);
---

<Base
  title="Connect this directory to your AI assistant"
  meta_title="Connect via MCP — Australian Wedding Celebrants"
  description="Add the Australian Wedding Celebrants MCP server to Claude, ChatGPT, Cursor, or any MCP-capable client. One URL, three steps."
  author={articleAuthor.name}
>
  <section class="py-16 md:py-20">
    <div class="container max-w-3xl">
      <!-- Hero -->
      <div class="mb-12 text-center">
        <div
          class="mb-5 inline-flex items-center gap-2 rounded-full px-4 py-1.5 text-sm text-white"
          style="font-weight: 600; background: #460479;"
        >
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M16 18l6-6-6-6"></path>
            <path d="M8 6l-6 6 6 6"></path>
          </svg>
          MCP server
        </div>
        <h1
          class="pretty mb-4"
          style="font-weight: 700; letter-spacing: -0.44px; line-height: 1.15;"
        >
          Connect this directory to your AI assistant
        </h1>
        <p
          class="text-light pretty mx-auto max-w-2xl"
          style="font-weight: 400; line-height: 1.6;"
        >
          Add one URL to Claude, ChatGPT, or your editor and your assistant can
          search the directory, browse by location or tier, and pull full
          celebrant profiles — right inside the chat.
        </p>
        <EditorialByline article={article} class="mt-4" />
      </div>

      <!-- URL card -->
      <div
        class="border-border mb-12 rounded-2xl border bg-white p-5"
        style="box-shadow: rgba(0,0,0,0.02) 0px 0px 0px 1px, rgba(0,0,0,0.04) 0px 2px 6px;"
      >
        <p
          class="text-light mb-2 text-xs"
          style="letter-spacing: 0.08em; text-transform: uppercase; font-weight: 600;"
        >
          MCP server URL
        </p>
        <div class="flex flex-wrap items-center gap-3">
          <code
            id="mcp-url"
            class="min-w-0 flex-1 text-sm break-all"
            style="color: #460479; font-family: ui-monospace, SFMono-Regular, Menlo, monospace;"
            >{mcpUrl}</code
          >
          <button
            type="button"
            class="btn btn-primary text-sm no-underline"
            data-copy-mcp-url
          >
            Copy URL
          </button>
        </div>
      </div>

      <!-- Client instructions -->
      <section class="mb-12">
        <h2
          class="mb-6"
          style="font-weight: 700; letter-spacing: -0.32px; font-size: 1.4rem;"
        >
          Add it to your client
        </h2>

        <div class="space-y-4">
          <details class="border-border rounded-2xl border bg-white p-5">
            <summary
              class="flex cursor-pointer items-center justify-between"
              style="font-weight: 600; letter-spacing: -0.18px;"
            >
              <span>Claude (claude.ai or Claude Desktop)</span>
              <span class="summary-icon" style="color: #92174d;">+</span>
            </summary>
            <ol
              class="text-light mt-4 ml-5 space-y-2"
              style="font-weight: 400; line-height: 1.6;"
            >
              <li>Open <strong>Settings → Connectors</strong>.</li>
              <li>Click <strong>Add custom connector</strong>.</li>
              <li>
                Paste the URL above and name it something like <em
                  >Australian Wedding Celebrants</em
                >.
              </li>
              <li>Save. The tools appear in any new conversation.</li>
            </ol>
          </details>

          <details class="border-border rounded-2xl border bg-white p-5">
            <summary
              class="flex cursor-pointer items-center justify-between"
              style="font-weight: 600; letter-spacing: -0.18px;"
            >
              <span>ChatGPT</span>
              <span class="summary-icon" style="color: #92174d;">+</span>
            </summary>
            <ol
              class="text-light mt-4 ml-5 space-y-2"
              style="font-weight: 400; line-height: 1.6;"
            >
              <li>
                Open <strong>Settings → Connectors</strong> (Apps SDK / MCP).
              </li>
              <li>Add a new MCP server and paste the URL above.</li>
              <li>
                The directory tools surface alongside any other connectors
                you've added.
              </li>
            </ol>
          </details>

          <details class="border-border rounded-2xl border bg-white p-5">
            <summary
              class="flex cursor-pointer items-center justify-between"
              style="font-weight: 600; letter-spacing: -0.18px;"
            >
              <span>Cursor, Windsurf, Zed, or other editors</span>
              <span class="summary-icon" style="color: #92174d;">+</span>
            </summary>
            <div
              class="text-light mt-4"
              style="font-weight: 400; line-height: 1.6;"
            >
              <p class="mb-3">Add this to your MCP config:</p>
              <pre
                class="bg-theme-light overflow-x-auto rounded p-3 text-xs"
                style="line-height: 1.5;"><code>{`{
  "mcpServers": {
    "australian-wedding-celebrants": {
      "url": "${mcpUrl}"
    }
  }
}`}</code></pre>
            </div>
          </details>

          <details class="border-border rounded-2xl border bg-white p-5">
            <summary
              class="flex cursor-pointer items-center justify-between"
              style="font-weight: 600; letter-spacing: -0.18px;"
            >
              <span>Test it from the command line</span>
              <span class="summary-icon" style="color: #92174d;">+</span>
            </summary>
            <div
              class="text-light mt-4"
              style="font-weight: 400; line-height: 1.6;"
            >
              <p class="mb-3">Quick sanity-check with curl:</p>
              <pre
                class="bg-theme-light overflow-x-auto rounded p-3 text-xs"
                style="line-height: 1.5;"><code>{`curl -X POST ${mcpUrl} \\
  -H 'Content-Type: application/json' \\
  -d '{"jsonrpc":"2.0","id":1,"method":"tools/list"}'`}</code></pre>
            </div>
          </details>
        </div>
      </section>

      <!-- What it can do -->
      <section class="mb-12">
        <h2
          class="mb-6"
          style="font-weight: 700; letter-spacing: -0.32px; font-size: 1.4rem;"
        >
          What you can ask
        </h2>
        <ul
          class="text-light space-y-3"
          style="font-weight: 400; line-height: 1.6;"
        >
          <li>🔎 <strong>Search</strong> by name, location, or specialty.</li>
          <li>
            📍 <strong>Browse by location</strong> — local celebrants plus anyone
            who travels Australia-wide.
          </li>
          <li>
            ⭐ <strong>Filter by tier</strong> — Luminary, Endorsed, or Registered.
          </li>
          <li>
            📄 <strong>Pull a full profile</strong> — bio, awards, testimonials, contact
            details.
          </li>
          <li>
            📚 <strong>List the whole directory</strong> for broader context.
          </li>
        </ul>
        <p class="text-light mt-6 text-sm" style="font-weight: 400;">
          The server is <strong>read-only</strong>. An assistant can browse but
          can't change any listing.
        </p>
      </section>

      <!-- CTAs -->
      <section class="border-border border-t pt-8 text-center">
        <p class="text-light pretty mb-6" style="font-weight: 400;">
          Curious about the full agent-discovery stack — robots.txt signals, A2A
          relay, llms.txt, the lot?
        </p>
        <div class="flex flex-wrap justify-center gap-3">
          <a href="/ai/" class="btn btn-primary no-underline"
            >How this site works with AI</a
          >
          <a href="/directory/" class="btn btn-outline-primary no-underline"
            >Browse the directory</a
          >
        </div>
      </section>
    </div>
  </section>

  <script>
    document.addEventListener("click", async (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const button = target.closest<HTMLButtonElement>("[data-copy-mcp-url]");
      if (!button) return;

      const mcpUrl = document
        .querySelector<HTMLElement>("#mcp-url")
        ?.textContent?.trim();
      if (!mcpUrl || !navigator.clipboard) {
        button.textContent = "Copy failed";
        return;
      }

      try {
        await navigator.clipboard.writeText(mcpUrl);
        button.textContent = "Copied";
        window.setTimeout(() => {
          if (button.isConnected) button.textContent = "Copy URL";
        }, 1500);
      } catch {
        button.textContent = "Copy failed";
      }
    });
  </script>
</Base>

<style>
  .pretty {
    text-wrap: pretty;
  }
  code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, monospace;
  }
  details summary::-webkit-details-marker {
    display: none;
  }
  details summary {
    list-style: none;
  }
  details[open] .summary-icon {
    transform: rotate(45deg);
  }
  .summary-icon {
    font-size: 1.25rem;
    line-height: 1;
    transition: transform 0.2s ease;
    display: inline-block;
  }
</style>
