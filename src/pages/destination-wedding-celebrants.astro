---
import Base from "@/layouts/Base.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import MasonryGrid from "@/components/MasonryGrid.astro";

const allItems = await getSinglePage("directory");
const tierOrder = { luminary: 0, endorsed: 1, registered: 2 };
const items = allItems.filter((item) => item.data.international === true);
// Fisher-Yates shuffle first for fair random ordering
for (let i = items.length - 1; i > 0; i--) {
  const j = Math.floor(Math.random() * (i + 1));
  [items[i], items[j]] = [items[j], items[i]];
}
// Stable sort by tier priority (preserves random order within each tier)
items.sort((a, b) => {
  const tierA = tierOrder[a.data.tier || "registered"] ?? 2;
  const tierB = tierOrder[b.data.tier || "registered"] ?? 2;
  return tierA - tierB;
});
---

<Base
  title="Destination Wedding Celebrants"
  meta_title="Destination Wedding Celebrants — Australian Wedding Celebrants"
  description="Meet Australian celebrants who travel for international and destination weddings."
>
  <section class="py-12 md:py-16">
    <div class="container">
      <div class="mb-12 text-center">
        <div
          class="pill-dark mb-4 inline-flex items-center gap-2 rounded-full px-4 py-1.5 text-sm"
          style="font-weight: 600;"
        >
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path d="M21.54 15H17a2 2 0 0 0-2 2v4.54"></path><path
              d="M7 3.34V5a3 3 0 0 0 3 3a2 2 0 0 1 2 2c0 1.1.9 2 2 2a2 2 0 0 0 2-2c0-1.1.9-2 2-2h3.17"
            ></path><path
              d="M11 21.95V18a2 2 0 0 0-2-2a2 2 0 0 1-2-2v-1a2 2 0 0 0-2-2H2.05"
            ></path><circle cx="12" cy="12" r="10"></circle></svg
          >
          Destination Weddings
        </div>
        <h1
          class="mb-4"
          style="font-weight: 700; letter-spacing: -0.44px; line-height: 1.2;"
        >
          Destination Wedding Celebrants
        </h1>
        <p
          class="text-light mx-auto max-w-2xl"
          style="font-weight: 400; line-height: 1.6;"
        >
          Meet {items.length} Australian celebrant{
            items.length !== 1 ? "s" : ""
          }
          who travel for international and destination weddings.
        </p>
      </div>

      <MasonryGrid items={items} />

      {
        items.length === 0 && (
          <div class="py-16 text-center">
            <p class="text-light text-lg">
              No destination wedding celebrants listed yet.{" "}
              <a href="/contact/" class="text-dark underline">
                Contact us
              </a>{" "}
              if you travel internationally.
            </p>
          </div>
        )
      }

      <div class="mt-12 text-center">
        <a href="/directory/" class="btn btn-outline-primary no-underline"
          >View All Celebrants</a
        >
      </div>
    </div>
  </section>
</Base>
