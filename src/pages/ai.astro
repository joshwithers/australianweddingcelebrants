---
import Base from "@/layouts/Base.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { serializeJsonLd } from "@/lib/utils/jsonLd";

const celebrants = await getSinglePage("directory");
const celebrantCount = celebrants.length;
const optedOut = celebrants.filter(
  (c) => c.data.accepts_agent_enquiries === false,
).length;

const siteUrl = "https://australianweddingcelebrants.com.au";
const workerUrl = "https://api.australianweddingcelebrants.com.au";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Does this website let AI companies train on celebrant profiles?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "No. Our robots.txt carries a Content-Signal directive of ai-train=no, which asks compliant crawlers not to use celebrant bios as training data. We allow search indexing (search=yes) and AI-assisted answers (ai-input=yes) because those help couples find a celebrant — which is what every celebrant on this site wants.",
      },
    },
    {
      "@type": "Question",
      name: "How does an AI assistant actually find a celebrant on this site?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "We publish a DNS for AI Discovery organisation index, machine-readable versions of every page (llms.txt, directory.json, .md endpoints), and a proper MCP server at api.australianweddingcelebrants.com.au/mcp that an AI agent can call to search, browse by location or tier, and fetch full profiles. We also expose the same capabilities through A2A so one agent can delegate to another.",
      },
    },
    {
      "@type": "Question",
      name: "Does an agent need an account, API key, or OAuth token?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "No. The public directory, machine-readable datasets, MCP search tools, and A2A interface are available anonymously. Agents do not need to register or send credentials. We publish this policy at /auth.md. Validation and rate limits protect against abuse but are not authentication.",
      },
    },
    {
      "@type": "Question",
      name: "Can agents email celebrants on behalf of couples?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes, through the A2A enquire_celebrant skill. The couple's assistant sends us a qualified payload (couple name + email, wedding date, location, detailed notes), we validate and rate-limit it, then email the celebrant with the couple as Reply-To. The celebrant replies directly — the directory is not in the loop. No commission, no contract, pass-through only.",
      },
    },
    {
      "@type": "Question",
      name: "Can a celebrant opt out of agent-relayed enquiries?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes. Every celebrant can uncheck 'Let AI agents relay wedding enquiries to my email address' on their listing edit page. We'll immediately stop relaying enquiries to them. No questions asked.",
      },
    },
  ],
};
---

<Base
  title="How this site works with AI, search engines & bots"
  meta_title="AI & Agent Discovery — Australian Wedding Celebrants"
  description="A plain-English walkthrough of every way this directory makes itself useful to search engines, LLMs, and autonomous agents — from robots.txt through MCP and A2A."
>
  <script
    is:inline
    type="application/ld+json"
    set:html={serializeJsonLd(faqSchema)}
  />

  <section class="py-16 md:py-20">
    <div class="container max-w-4xl">
      <!-- Hero -->
      <div class="mb-16 text-center">
        <div
          class="mb-5 inline-flex items-center gap-2 rounded-full px-4 py-1.5 text-sm text-white"
          style="font-weight: 600; background: #460479;"
        >
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path
              d="M12 2a7 7 0 0 0-7 7c0 2.5 1.3 4.7 3.3 6l-.3 5h8l-.3-5c2-1.3 3.3-3.5 3.3-6a7 7 0 0 0-7-7z"
            ></path>
            <path d="M9 18h6"></path>
            <path d="M10 22h4"></path>
          </svg>
          AI & agent discovery
        </div>
        <h1
          class="pretty mb-4"
          style="font-weight: 700; letter-spacing: -0.44px; line-height: 1.15;"
        >
          How this site works with AI, search engines, and bots
        </h1>
        <p
          class="text-light pretty mx-auto max-w-2xl"
          style="font-weight: 400; line-height: 1.6;"
        >
          A plain-English walkthrough of every machine-readable surface this
          directory publishes — why it's there, who it helps, and a link to the
          live endpoint so you can inspect it yourself.
        </p>
      </div>

      <!-- TL;DR split by audience -->
      <div class="mb-16 grid gap-6 md:grid-cols-2">
        <div class="border-border rounded-2xl border bg-white p-6">
          <h2
            class="mb-3 text-lg"
            style="font-weight: 600; letter-spacing: -0.22px;"
          >
            If you're a couple planning a wedding
          </h2>
          <p class="text-light" style="font-weight: 400; line-height: 1.6;">
            Ask your AI assistant — ChatGPT, Claude, Perplexity, a dedicated
            wedding planner bot — for celebrant recommendations in Australia. It
            can read every profile on this site, search by location or
            specialty, and even email a shortlisted celebrant on your behalf
            through our relay. You stay in control: the celebrant replies to
            your email, you take the conversation from there, and we're not
            involved in the booking.
          </p>
        </div>
        <div class="border-border rounded-2xl border bg-white p-6">
          <h2
            class="mb-3 text-lg"
            style="font-weight: 600; letter-spacing: -0.22px;"
          >
            If you're a celebrant
          </h2>
          <p class="text-light" style="font-weight: 400; line-height: 1.6;">
            Being in this directory means your public profile is genuinely
            visible to the new generation of AI tools couples use to plan. We've
            built — and maintain — the discovery plumbing ({celebrantCount} celebrants
            indexed today). When an assistant recommends you, the enquiry that lands
            in your inbox has a date, a location, and a real couple behind it. You
            opt in by default; opt out any time from your listing edit page.
          </p>
        </div>
      </div>

      <!-- Stats strip -->
      <div class="mb-16 grid grid-cols-2 gap-4 text-center md:grid-cols-4">
        <div class="bg-theme-light rounded-2xl p-5">
          <div class="text-2xl" style="font-weight: 700;">{celebrantCount}</div>
          <div class="text-light text-sm" style="font-weight: 400;">
            celebrants indexed
          </div>
        </div>
        <div class="bg-theme-light rounded-2xl p-5">
          <div class="text-2xl" style="font-weight: 700;">
            {celebrantCount - optedOut}
          </div>
          <div class="text-light text-sm" style="font-weight: 400;">
            accepting agent enquiries
          </div>
        </div>
        <div class="bg-theme-light rounded-2xl p-5">
          <div class="text-2xl" style="font-weight: 700;">16</div>
          <div class="text-light text-sm" style="font-weight: 400;">
            agent surfaces live
          </div>
        </div>
        <div class="bg-theme-light rounded-2xl p-5">
          <div class="text-2xl" style="font-weight: 700;">0</div>
          <div class="text-light text-sm" style="font-weight: 400;">
            commissions taken
          </div>
        </div>
      </div>

      <!-- Section: Preferences & signals -->
      <section class="mb-16">
        <h2
          class="mb-2"
          style="font-weight: 700; letter-spacing: -0.32px; font-size: 1.6rem;"
        >
          Preferences & signals
        </h2>
        <p class="text-light mb-8" style="font-weight: 400;">
          What this site asks bots to do — and not do.
        </p>

        <div class="space-y-6">
          <article class="border-border rounded-2xl border bg-white p-6">
            <div class="mb-2 flex flex-wrap items-baseline gap-3">
              <h3
                style="font-weight: 600; letter-spacing: -0.22px; font-size: 1.15rem; margin: 0;"
              >
                Authentication policy (auth.md)
              </h3>
              <a
                href="/auth.md"
                class="text-sm"
                style="color: #460479; font-weight: 500;">/auth.md →</a
              >
            </div>
            <p class="text-light" style="font-weight: 400; line-height: 1.6;">
              This is a public directory: people and agents can browse the site,
              read the datasets, search through MCP, and use the A2A interface
              without an account, API key, or OAuth token. The <code
                >auth.md</code
              > file publishes that anonymous-access policy in one machine-readable
              place. We intentionally do not publish OAuth or OpenID Connect discovery
              metadata because this public service does not operate an authorization
              server or issue access tokens.
            </p>
          </article>

          <article class="border-border rounded-2xl border bg-white p-6">
            <div class="mb-2 flex flex-wrap items-baseline gap-3">
              <h3
                style="font-weight: 600; letter-spacing: -0.22px; font-size: 1.15rem; margin: 0;"
              >
                robots.txt with Content Signals
              </h3>
              <a
                href="/robots.txt"
                class="text-sm"
                style="color: #460479; font-weight: 500;">/robots.txt →</a
              >
            </div>
            <p class="text-light" style="font-weight: 400; line-height: 1.6;">
              Alongside the standard Allow directives, we publish a
              Content-Signal line from the
              <a href="https://contentsignals.org/" rel="nofollow"
                >contentsignals.org</a
              > draft:
              <code>ai-train=no, search=yes, ai-input=yes</code>. In plain
              English: <em
                >don't harvest celebrant bios for model training, but please do
                index us for search and cite us in AI-assisted answers.</em
              > That lets couples find celebrants through the AI tools they already
              use, without turning the directory into free training data.
            </p>
          </article>

          <article class="border-border rounded-2xl border bg-white p-6">
            <div class="mb-2 flex flex-wrap items-baseline gap-3">
              <h3
                style="font-weight: 600; letter-spacing: -0.22px; font-size: 1.15rem; margin: 0;"
              >
                Link headers on every page (RFC 8288)
              </h3>
            </div>
            <p class="text-light" style="font-weight: 400; line-height: 1.6;">
              Every HTTP response on this site carries <code>Link</code> headers pointing
              at the machine-readable versions of the content — the <code
                >service-desc</code
              >, <code>describedby</code>, <code>sitemap</code>, <code
                >api-catalog</code
              >, <code>agent-skills</code>, and <code>a2a-agent-card</code> relations.
              An agent that lands on any page can follow these without scraping to
              find the structured data.
            </p>
            <p class="text-light mt-3 text-sm" style="font-weight: 400;">
              Verify with <code
                >curl -sI https://australianweddingcelebrants.com.au/ | grep -i
                '^link:'</code
              >
            </p>
          </article>

          <article class="border-border rounded-2xl border bg-white p-6">
            <div class="mb-2 flex flex-wrap items-baseline gap-3">
              <h3
                style="font-weight: 600; letter-spacing: -0.22px; font-size: 1.15rem; margin: 0;"
              >
                Sitemap
              </h3>
              <a
                href="/sitemap-index.xml"
                class="text-sm"
                style="color: #460479; font-weight: 500;"
                >/sitemap-index.xml →</a
              >
            </div>
            <p class="text-light" style="font-weight: 400; line-height: 1.6;">
              Auto-generated list of every URL on the site, refreshed every
              build. Useful for Google/Bing and any crawler-style agent doing
              bulk ingestion.
            </p>
          </article>
        </div>
      </section>

      <!-- Section: Machine-readable content -->
      <section class="mb-16">
        <h2
          class="mb-2"
          style="font-weight: 700; letter-spacing: -0.32px; font-size: 1.6rem;"
        >
          Machine-readable content
        </h2>
        <p class="text-light mb-8" style="font-weight: 400;">
          The site content, but in formats an LLM can actually digest.
        </p>

        <div class="space-y-6">
          <article class="border-border rounded-2xl border bg-white p-6">
            <div class="mb-2 flex flex-wrap items-baseline gap-3">
              <h3
                style="font-weight: 600; letter-spacing: -0.22px; font-size: 1.15rem; margin: 0;"
              >
                llms.txt & llms-full.txt
              </h3>
              <a
                href="/llms.txt"
                class="text-sm"
                style="color: #460479; font-weight: 500;">/llms.txt →</a
              >
              <a
                href="/llms-full.txt"
                class="text-sm"
                style="color: #460479; font-weight: 500;">/llms-full.txt →</a
              >
            </div>
            <p class="text-light" style="font-weight: 400; line-height: 1.6;">
              Following the <a href="https://llmstxt.org/" rel="nofollow"
                >llmstxt.org</a
              > convention: a concise text summary of the site (who we are, tier system,
              all celebrants with tier, location, and URL) plus a full-dump variant
              that inlines every celebrant's body copy. An LLM that wants broad context
              in one fetch can read these instead of crawling the HTML.
            </p>
          </article>

          <article class="border-border rounded-2xl border bg-white p-6">
            <div class="mb-2 flex flex-wrap items-baseline gap-3">
              <h3
                style="font-weight: 600; letter-spacing: -0.22px; font-size: 1.15rem; margin: 0;"
              >
                Markdown for Agents
              </h3>
              <a
                href={`${siteUrl}/index.md`}
                class="text-sm"
                style="color: #460479; font-weight: 500;">/index.md →</a
              >
              <a
                href={`${siteUrl}/directory/josh-withers-ybt9.md`}
                class="text-sm"
                style="color: #460479; font-weight: 500;">Sample profile.md →</a
              >
            </div>
            <p class="text-light" style="font-weight: 400; line-height: 1.6;">
              Every HTML page has a markdown counterpart. Request any URL on
              this site with <code>Accept: text/markdown</code> and you'll get the
              markdown version with <code>Content-Type: text/markdown</code> and an
              <code>X-Markdown-Tokens</code> estimate — a Cloudflare Pages Function
              at the edge swaps the response. Browsers still get HTML; agents get
              the cleaner token-efficient version.
            </p>
            <p class="text-light mt-3 text-sm" style="font-weight: 400;">
              Try: <code
                >curl -H 'Accept: text/markdown'
                https://australianweddingcelebrants.com.au/</code
              >
            </p>
          </article>

          <article class="border-border rounded-2xl border bg-white p-6">
            <div class="mb-2 flex flex-wrap items-baseline gap-3">
              <h3
                style="font-weight: 600; letter-spacing: -0.22px; font-size: 1.15rem; margin: 0;"
              >
                Structured JSON dataset
              </h3>
              <a
                href="/directory.json"
                class="text-sm"
                style="color: #460479; font-weight: 500;">/directory.json →</a
              >
            </div>
            <p class="text-light" style="font-weight: 400; line-height: 1.6;">
              Every celebrant as typed JSON — slug, tier, locations, categories, <code
                >australia_wide</code
              > / <code>international</code> flags, contact fields, profile URLs.
              Updated on every build. This is the backbone that the MCP server and
              A2A agent both read from.
            </p>
          </article>
        </div>
      </section>

      <!-- Section: Agent discovery -->
      <section class="mb-16">
        <h2
          class="mb-2"
          style="font-weight: 700; letter-spacing: -0.32px; font-size: 1.6rem;"
        >
          Agent discovery
        </h2>
        <p class="text-light mb-8" style="font-weight: 400;">
          A DNS entrypoint and well-known URLs where agents look first to figure
          out what we offer.
        </p>

        <div class="space-y-6">
          <article class="border-border rounded-2xl border bg-white p-6">
            <div class="mb-2 flex flex-wrap items-baseline gap-3">
              <h3
                style="font-weight: 600; letter-spacing: -0.22px; font-size: 1.15rem; margin: 0;"
              >
                API catalog (RFC 9727)
              </h3>
              <a
                href="/.well-known/api-catalog"
                class="text-sm"
                style="color: #460479; font-weight: 500;"
                >/.well-known/api-catalog →</a
              >
            </div>
            <p class="text-light" style="font-weight: 400; line-height: 1.6;">
              An <code>application/linkset+json</code> document that advertises every
              machine-readable surface we run — the directory dataset, the MCP endpoint,
              the A2A endpoint — each with its spec URL and docs. Lets an agent find
              everything in one GET.
            </p>
          </article>

          <article class="border-border rounded-2xl border bg-white p-6">
            <div class="mb-2 flex flex-wrap items-baseline gap-3">
              <h3
                style="font-weight: 600; letter-spacing: -0.22px; font-size: 1.15rem; margin: 0;"
              >
                DNS for AI Discovery (DNS-AID)
              </h3>
              <a
                href="https://datatracker.ietf.org/doc/draft-mozleywilliams-dnsop-dnsaid/"
                rel="nofollow"
                class="text-sm"
                style="color: #460479; font-weight: 500;"
                >Current Internet-Draft →</a
              >
            </div>
            <p class="text-light" style="font-weight: 400; line-height: 1.6;">
              Agents can discover the directory before making an HTTP request by
              resolving <code
                >_index._agents.australianweddingcelebrants.com.au</code
              >. Its HTTPS ServiceMode record has priority <code>1</code>,
              targets this canonical site, advertises <code>h2</code> and <code
                >http/1.1</code
              > on port <code>443</code>, and is authenticated through DNSSEC.
              DNS-AID is an experimental Internet-Draft rather than a final
              standard; the HTTPS record format follows RFC 9460.
            </p>
          </article>

          <article class="border-border rounded-2xl border bg-white p-6">
            <div class="mb-2 flex flex-wrap items-baseline gap-3">
              <h3
                style="font-weight: 600; letter-spacing: -0.22px; font-size: 1.15rem; margin: 0;"
              >
                MCP Server Card (SEP-1649)
              </h3>
              <a
                href="/.well-known/mcp/server-card.json"
                class="text-sm"
                style="color: #460479; font-weight: 500;"
                >/.well-known/mcp/server-card.json →</a
              >
            </div>
            <p class="text-light" style="font-weight: 400; line-height: 1.6;">
              The static discovery card for our MCP server. Advertises the
              transport (<code>http</code>), endpoint URL, and identity. This is
              how an MCP-capable assistant finds our server without being
              hard-coded to it.
            </p>
          </article>

          <article class="border-border rounded-2xl border bg-white p-6">
            <div class="mb-2 flex flex-wrap items-baseline gap-3">
              <h3
                style="font-weight: 600; letter-spacing: -0.22px; font-size: 1.15rem; margin: 0;"
              >
                Agent Skills index (v0.2.0)
              </h3>
              <a
                href="/.well-known/agent-skills/index.json"
                class="text-sm"
                style="color: #460479; font-weight: 500;"
                >/.well-known/agent-skills/index.json →</a
              >
              <a
                href="/.well-known/agent-skills/find-australian-wedding-celebrant/SKILL.md"
                class="text-sm"
                style="color: #460479; font-weight: 500;">SKILL.md →</a
              >
            </div>
            <p class="text-light" style="font-weight: 400; line-height: 1.6;">
              A published skill (<code>find-australian-wedding-celebrant</code>)
              that teaches any agent how to use this directory well — when to
              trigger, how to explain tiers, a recommended 5-step flow, and the
              common pitfalls to avoid. The index is auto-regenerated on every
              build with a SHA-256 digest so clients can verify they've got the
              right version.
            </p>
          </article>

          <article class="border-border rounded-2xl border bg-white p-6">
            <div class="mb-2 flex flex-wrap items-baseline gap-3">
              <h3
                style="font-weight: 600; letter-spacing: -0.22px; font-size: 1.15rem; margin: 0;"
              >
                A2A Agent Card
              </h3>
              <a
                href="/.well-known/agent-card.json"
                class="text-sm"
                style="color: #460479; font-weight: 500;"
                >/.well-known/agent-card.json →</a
              >
            </div>
            <p class="text-light" style="font-weight: 400; line-height: 1.6;">
              The standard <a href="https://a2a-protocol.org/" rel="nofollow"
                >A2A protocol</a
              > card. Names this site as an agent that other agents can delegate to,
              lists our two skills (<code>search_celebrants</code> and <code
                >enquire_celebrant</code
              >), and publishes the endpoint.
            </p>
          </article>
        </div>
      </section>

      <!-- Section: Live endpoints -->
      <section class="mb-16">
        <h2
          class="mb-2"
          style="font-weight: 700; letter-spacing: -0.32px; font-size: 1.6rem;"
        >
          Live endpoints
        </h2>
        <p class="text-light mb-8" style="font-weight: 400;">
          The services behind the discovery cards.
        </p>

        <div class="space-y-6">
          <article class="border-border rounded-2xl border bg-white p-6">
            <div class="mb-2 flex flex-wrap items-baseline gap-3">
              <h3
                style="font-weight: 600; letter-spacing: -0.22px; font-size: 1.15rem; margin: 0;"
              >
                MCP server
              </h3>
              <a
                href={`${workerUrl}/mcp`}
                class="text-sm"
                style="color: #460479; font-weight: 500;">{workerUrl}/mcp →</a
              >
            </div>
            <p class="text-light" style="font-weight: 400; line-height: 1.6;">
              A Model Context Protocol server (Streamable HTTP transport,
              protocol version 2025-06-18) running on our Cloudflare Worker.
              Exposes five read-only tools: <code>search_celebrants</code>, <code
                >browse_by_location</code
              > (includes celebrants who travel Australia-wide), <code
                >browse_by_tier</code
              >, <code>get_celebrant_profile</code>, and <code
                >list_all_celebrants</code
              >. Any MCP-capable client — Claude Desktop, Cursor, Zed, a custom
              agent — can connect and use it.
            </p>
            <details class="mt-3">
              <summary
                class="text-sm"
                style="color: #460479; font-weight: 500; cursor: pointer;"
                >Show a sample call</summary
              >
              <pre
                class="bg-theme-light mt-2 overflow-x-auto rounded p-3 text-xs"
                style="line-height: 1.5;"><code>curl -X POST {workerUrl}/mcp \
  -H 'Content-Type: application/json' \
  -d {"'"}{"{"}"jsonrpc":"2.0","id":1,"method":"tools/call",
       "params":{"{"}"name":"search_celebrants",
                 "arguments":{"{"}"query":"byron bay"{"}"}{"}"}{"}"}{"'"}</code></pre>
            </details>
          </article>

          <article class="border-border rounded-2xl border bg-white p-6">
            <div class="mb-2 flex flex-wrap items-baseline gap-3">
              <h3
                style="font-weight: 600; letter-spacing: -0.22px; font-size: 1.15rem; margin: 0;"
              >
                A2A agent & enquiry relay
              </h3>
              <a
                href={`${workerUrl}/a2a`}
                class="text-sm"
                style="color: #460479; font-weight: 500;">{workerUrl}/a2a →</a
              >
            </div>
            <p class="text-light" style="font-weight: 400; line-height: 1.6;">
              An Agent-to-Agent endpoint for assistants that want to delegate a
              task rather than call tools. The headline skill is <code
                >enquire_celebrant</code
              >: a couple's planning assistant sends a qualified payload (couple
              name + email, wedding date, location, at least 30 characters of
              ceremony notes), we validate and rate-limit, and we email the
              celebrant with the couple as Reply-To. The celebrant and the
              couple take it from there — we don't sit in the middle of the
              conversation.
            </p>
            <p
              class="text-light mt-3"
              style="font-weight: 400; line-height: 1.6;"
            >
              <strong>What we commit to:</strong> no commission, no contract, no interference
              in the booking. We're a free pass-through for celebrants in the directory.
              Couples see our disclaimer on every A2A response; celebrants see it
              in plain English in every enquiry email. Celebrants can opt out of agent-relayed
              enquiries at any time.
            </p>
            <p
