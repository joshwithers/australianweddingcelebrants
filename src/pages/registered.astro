---
import Base from "@/layouts/Base.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import MasonryGrid from "@/components/MasonryGrid.astro";

const allItems = await getSinglePage("directory");
const items = allItems.filter(
  (item) => (item.data.tier || "registered") === "registered",
);
// Fisher-Yates shuffle for fair random ordering
for (let i = items.length - 1; i > 0; i--) {
  const j = Math.floor(Math.random() * (i + 1));
  [items[i], items[j]] = [items[j], items[i]];
}
---

<Base
  title="Registered Celebrants"
  meta_title="Registered Celebrants — Australian Wedding Celebrants"
  description="Browse Registered credentials issued and human verified by Australian Wedding Celebrants against its published foundation standard."
>
  <section class="py-12 md:py-16">
    <div class="container">
      <div class="mb-12 text-center">
        <div
          class="text-light border-border mb-4 inline-flex items-center gap-2 rounded-full border px-4 py-1.5 text-sm"
          style="font-weight: 500;"
        >
          Registered
        </div>
        <h1
          class="mb-4"
          style="font-weight: 700; letter-spacing: -0.44px; line-height: 1.2;"
        >
          Registered Celebrants
        </h1>
        <p
          class="text-light mx-auto max-w-2xl"
          style="font-weight: 400; line-height: 1.6;"
        >
          These {items.length} profiles carry the publisher's Registered directory
          credential, issued after human verification against our published standard.
          That standard requires Commonwealth authorisation and a Certificate IV in
          Celebrancy or equivalent qualification.
        </p>
      </div>

      <MasonryGrid items={items} />

      {
        items.length === 0 && (
          <div class="py-16 text-center">
            <p class="text-light text-lg">No registered celebrants found.</p>
          </div>
        )
      }

      <div class="mt-12 text-center">
        <a href="/directory/" class="btn btn-outline-primary no-underline"
          >View All Celebrants</a
        >
      </div>
    </div>
  </section>
</Base>
