  {/* How it works */}
  <section class="border-border border-t py-16 md:py-24">
    <div class="container max-w-3xl">
      <h2
        class="mb-12 text-center"
        style="font-weight: 700; letter-spacing: -0.44px;"
      >
        How It Works
      </h2>

      <div class="space-y-10">
        <div class="flex gap-5">
          <div
            class="bg-dark flex h-10 w-10 flex-none items-center justify-center rounded-full text-sm text-white"
            style="font-weight: 600;"
          >
            1
          </div>
          <div>
            <h3
              class="mb-2 text-base"
              style="font-weight: 600; letter-spacing: -0.18px;"
            >
              Join the directory
            </h3>
            <p
              class="text-light text-sm"
              style="font-weight: 400; line-height: 1.6;"
            >
              All Commonwealth authorised marriage celebrants can join our
              directory at the Registered tier. Complete your profile with a
              professional photo, description, website, and contact details.
              There is no fee to be listed — this directory exists to connect
              couples with professionals, not to sell advertising.
            </p>
          </div>
        </div>

        <div class="flex gap-5">
          <div
            class="flex h-10 w-10 flex-none items-center justify-center rounded-full text-sm text-white"
            style="font-weight: 600; background: #92174d;"
          >
            2
          </div>
          <div>
            <h3
              class="mb-2 text-base"
              style="font-weight: 600; letter-spacing: -0.18px;"
            >
              Prove you're Endorsed
