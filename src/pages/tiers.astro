                  class="text-dark mt-0.5 h-4 w-4 flex-none"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  ><path
                    d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"
                  ></path></svg
                >
                Registered as a Commonwealth authorised marriage celebrant under the
                Marriage Act 1961
              </li>
              <li
                class="text-light flex items-start gap-2.5 text-sm"
                style="font-weight: 400;"
              >
                <svg
                  class="text-dark mt-0.5 h-4 w-4 flex-none"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  ><path
                    d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"
                  ></path></svg
                >
                Certificate IV in Celebrancy or equivalent qualification
              </li>
              <li
                class="text-light flex items-start gap-2.5 text-sm"
                style="font-weight: 400;"
              >
                <svg
                  class="text-dark mt-0.5 h-4 w-4 flex-none"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  ><path
                    d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"
                  ></path></svg
                >
                Complete directory profile with professional photo, description, website,
                and contact details
              </li>
            </ul>
            <a
              href="/registered/"
              class="text-dark mt-6 inline-flex items-center gap-1.5 text-sm no-underline hover:underline"
              style="font-weight: 500;"
            >
              View all registered celebrants
              <svg
                class="h-4 w-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                ><path
                  d="M5 12h14m-7-7l7 7-7 7"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path></svg
              >
            </a>
          </div>
        </div>

        {/* Endorsed */}
        <div class="">
          <div
            class="rounded-card h-full border-2 p-8 md:p-10"
            style="border-color: #92174d;"
          >
            <div class="mb-6">
              <div
                class="inline-flex items-center gap-2 rounded-full px-4 py-1.5 text-sm text-white"
                style="font-weight: 600; background: #92174d;"
              >
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  ><path
                    d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"
                  ></path></svg
                >
                Endorsed
              </div>
            </div>
            <h2
              class="mb-3 text-xl"
              style="font-weight: 700; letter-spacing: -0.18px;"
            >
              Endorsed Celebrant
            </h2>
            <p
              class="text-light mb-6 text-sm"
              style="font-weight: 400; line-height: 1.6;"
