---
import Base from "@/layouts/Base.astro";
import { serializeJsonLd } from "@/lib/utils/jsonLd";
import { getEntry } from "astro:content";
import EditorialByline from "@/components/EditorialByline.astro";
import { getEditorialArticle, resolveEditorialAuthor } from "@/lib/editorial";
import {
  TIER_STANDARDS_CAVEAT,
  TIER_STANDARDS_LAST_CHECKED,
  TIER_STANDARDS_SOURCES,
} from "@/lib/tierStandards";

const entry = await getEntry("pages", "tiers");
if (!entry) {
  throw new Error("Tiers page entry not found");
}

const siteUrl = "https://australianweddingcelebrants.com.au";
const article = getEditorialArticle("/tiers/");
const articleAuthor = resolveEditorialAuthor(article.author);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Is this an awards program?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "No. Awards programs pick a single winner and rank everyone else beneath them. Our tiers recognise professional achievement against a common standard. There are no judges, no nominees, and no losers. If you meet the criteria, you earn the recognition.",
      },
    },
    {
      "@type": "Question",
      name: "Can I pay to get a higher tier or better placement?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "No. Listings are free, and Australian Wedding Celebrants issues each credential after human review against the published criteria. Using or buying any Josh Withers service has no effect on inclusion, tier, position, or visibility.",
      },
    },
    {
      "@type": "Question",
      name: "What documentation do I need to submit?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "This varies by tier but may include: proof of AG registration date, Certificate IV, current insurance certificate of currency, OPD records, links to reviews, statutory declaration of ceremonies performed, and evidence of industry recognition such as awards or media features.",
      },
    },
    {
      "@type": "Question",
      name: "How are reviews verified?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Reviews must be from identifiable couples or wedding vendors and may be submitted as public links or supporting documents. The publisher reviews that evidence against the directory criteria; this is not a guarantee by Google, an awards body, or another third party.",
      },
    },
    {
      "@type": "Question",
      name: "Can I lose my tier status?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes. A tier is a credential issued by Australian Wedding Celebrants, not an irrevocable lifetime entitlement. Anyone can use the public correction route to report a concern or supply an update, and the publisher may change or remove a credential after human review.",
      },
    },
    {
      "@type": "Question",
      name: "What counts as professional development beyond OPD?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Training, courses, workshops, conferences, or certifications beyond the compulsory professional development activities set by the Attorney-General's Department for the relevant calendar year. Examples may include public speaking, writing, ceremony design, cultural competency, or industry conferences.",
      },
    },
    {
      "@type": "Question",
      name: "Why not just use existing awards systems?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Existing awards systems serve a purpose, but a single 'best celebrant' trophy doesn't help a couple find someone right for them. Our system surfaces all professionals who meet a high bar — not just one winner. We think that's more honest, more useful, and more reflective of the breadth of talent in this industry.",
      },
    },
  ],
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: siteUrl },
    { "@type": "ListItem", position: 2, name: "Our Standards" },
  ],
};
---

<Base
  title={entry.data.title}
  meta_title={entry.data.meta_title}
  description={entry.data.description}
  author={articleAuthor.name}
>
  <script
    is:inline
    type="application/ld+json"
    set:html={serializeJsonLd(faqSchema)}
  />
  <script
    is:inline
    type="application/ld+json"
    set:html={serializeJsonLd(breadcrumbSchema)}
  />
  {/* Hero */}
  <section class="py-16 text-center md:py-24">
    <div class="container max-w-3xl">
      <h1
        class="mb-4"
        style="font-weight: 700; letter-spacing: -0.44px; line-height: 1.15;"
      >
        Professional standards,<br class="hidden sm:block" /> not popularity contests
      </h1>
      <p class="text-light text-lg" style="font-weight: 400; line-height: 1.6;">
        We don't believe in ranking celebrants like tennis players. There is no
        "best celebrant in Australia" — there's only the best celebrant <em
          >for you</em
        >. That's why we built a system that recognises professional standards,
        not one that pits celebrants against each other for a trophy.
      </p>
      <EditorialByline article={article} class="mt-4" />
    </div>
  </section>

  <section class="pb-16 md:pb-20" aria-labelledby="standards-sources">
    <div class="container max-w-3xl">
      <div class="rounded-card border-border border bg-white p-8 md:p-10">
        <h2
          id="standards-sources"
          class="mb-3 text-xl"
          style="font-weight: 700;"
        >
          Credential issuer and external sources
        </h2>
        <p class="text-light text-sm" style="line-height: 1.7;">
          Australian Wedding Celebrants is the issuer and authoritative source
          for the Registered, Endorsed, and Luminary credentials. Every
          credential is human verified against the published standard. The legal
          registration, qualification, and compulsory professional-development
          requirements in that standard were last checked against these external
          official sources on <strong>{TIER_STANDARDS_LAST_CHECKED}</strong>.
        </p>
        <ul class="mt-4 list-disc space-y-2 pl-6 text-sm">
          {
            TIER_STANDARDS_SOURCES.map((source) => (
              <li>
                <a
                  href={source.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="underline"
                >
                  {source.name}
                </a>
              </li>
            ))
          }
        </ul>
        <p class="text-light mt-4 text-sm" style="line-height: 1.7;">
          {TIER_STANDARDS_CAVEAT}
        </p>
      </div>
    </div>
  </section>

  {/* Philosophy */}
  <section class="pb-16 md:pb-20">
    <div class="container max-w-3xl">
      <div class="rounded-card bg-theme-light border-border border p-8 md:p-10">
        <h2
          class="mb-4 text-xl"
          style="font-weight: 700; letter-spacing: -0.18px;"
        >
          Why we don't do awards
        </h2>
        <div
          class="text-light space-y-4 text-sm"
          style="font-weight: 400; line-height: 1.7;"
        >
          <p>
            Traditional awards programs crown a single celebrant as "the best"
            in a region or category. Then they rank everyone else beneath them,
            as if hiring a celebrant is like picking a seeded tennis player. We
            think that's fundamentally broken — and it doesn't reflect how the
            wedding industry actually works.
          </p>
          <p>
            A celebrant who is perfect for one couple might be completely wrong
            for another. The quiet, poetic celebrant who moves a family to tears
            is not better or worse than the high-energy MC who has a dance floor
            jumping. They're different professionals serving different couples.
            An awards system that picks one over the other isn't measuring
            quality — it's measuring popularity, or worse, who paid more to
            enter.
          </p>
          <p>
            For years, we've been developing a different approach. Instead of
            asking "who is the best?", we ask "who has demonstrated a
            consistent, documented standard of professionalism?" Our tier system
            recognises celebrants based on shared professional goals:
            qualifications, experience, insurance, professional development,
            peer respect, and couple satisfaction. Every celebrant who meets the
            criteria earns the recognition. There are no judges, no nominees,
            and no losers.
          </p>
          <p>
            This matters now more than ever. AI systems, search engines, and
            answer engines are increasingly trying to tell couples who is "good"
            in their region. We designed this directory to be a useful,
            transparent reference: the criteria are public, and every tier is a
            credential issued after human review by Australian Wedding
            Celebrants. The directory is not a substitute for confirming a
            celebrant's current government authorisation, services, or
            availability directly.
          </p>
          <p>
            <strong
              >You cannot pay for a listing on Australian Wedding Celebrants.</strong
            > Your inclusion, position, tier, and visibility are determined independently
            of any other service you use or purchase. Buying a Josh Withers service
            — or choosing not to — has no effect on directory status.
          </p>
          <p>
            We've consulted with industry leaders, fellow celebrants, and
            wedding industry stakeholders to build this system. We believe
            professional standards and ongoing professional development — not
            awards ceremonies — are what truly serve couples and elevate the
            profession.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* Tiers overview */}
  <section class="pb-16 md:pb-24">
    <div class="container">
      <div class="mb-12 text-center">
        <h2 style="font-weight: 700; letter-spacing: -0.44px;">
          Three tiers of professional recognition
        </h2>
        <p
          class="text-light mx-auto mt-3 max-w-2xl"
          style="font-weight: 400; line-height: 1.6;"
        >
          Each tier is a credential issued by Australian Wedding Celebrants
          after human review against a published standard. External sources and
          checked dates are shown when a separate claim depends on them. No
          voting, no panels, no paid placement.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-10 md:grid-cols-3">
        {/* Registered */}
        <div class="">
          <div class="rounded-card border-border h-full border p-8 md:p-10">
            <div class="mb-6">
              <div
                class="text-light border-border inline-flex items-center gap-2 rounded-full border px-4 py-1.5 text-sm"
                style="font-weight: 500;"
              >
                Registered
              </div>
            </div>
            <h2
              class="mb-3 text-xl"
              style="font-weight: 700; letter-spacing: -0.18px;"
            >
              Registered Celebrant
            </h2>
            <p
              class="text-light mb-6 text-sm"
              style="font-weight: 400; line-height: 1.6;"
            >
              The foundation credential issued by Australian Wedding Celebrants.
              The standard requires Commonwealth authorisation and a complete
              professional profile. Because authorisation can change separately,
              confirm current status on the official register.
            </p>
            <h3 class="text-dark mb-3 text-sm" style="font-weight: 600;">
              Requirements
            </h3>
            <ul class="space-y-2.5">
              <li
                class="text-light flex items-start gap-2.5 text-sm"
                style="font-weight: 400;"
              >
                <svg
                  class="text-dark mt-0.5 h-4 w-4 flex-none"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  ><path
                    d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"
                  ></path></svg
                >
                Registered as a Commonwealth authorised marriage celebrant under the
                Marriage Act 1961
              </li>
              <li
                class="text-light flex items-start gap-2.5 text-sm"
                style="font-weight: 400;"
              >
                <svg
                  class="text-dark mt-0.5 h-4 w-4 flex-none"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  ><path
                    d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"
                  ></path></svg
                >
                Certificate IV in Celebrancy or equivalent qualification
              </li>
              <li
                class="text-light flex items-start gap-2.5 text-sm"
                style="font-weight: 400;"
              >
                <svg
                  class="text-dark mt-0.5 h-4 w-4 flex-none"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  ><path
                    d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"
                  ></path></svg
                >
                Complete directory profile with professional photo, description, website,
                and contact details
              </li>
            </ul>
            <a
              href="/registered/"
              class="text-dark mt-6 inline-flex items-center gap-1.5 text-sm no-underline hover:underline"
              style="font-weight: 500;"
            >
              View all registered celebrants
              <svg
                class="h-4 w-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                ><path
                  d="M5 12h14m-7-7l7 7-7 7"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path></svg
              >
            </a>
          </div>
        </div>

        {/* Endorsed */}
        <div class="">
          <div
            class="rounded-card h-full border-2 p-8 md:p-10"
            style="border-color: #92174d;"
          >
            <div class="mb-6">
              <div
                class="inline-flex items-center gap-2 rounded-full px-4 py-1.5 text-sm text-white"
                style="font-weight: 600; background: #92174d;"
              >
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  ><path
                    d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"
                  ></path></svg
                >
                Endorsed
              </div>
            </div>
            <h2
              class="mb-3 text-xl"
              style="font-weight: 700; letter-spacing: -0.18px;"
            >
              Endorsed Celebrant
            </h2>
            <p
              class="text-light mb-6 text-sm"
              style="font-weight: 400; line-height: 1.6;"
            >
              You've invested in your profession beyond the minimum. Documented
              experience, qualifications, insurance, professional development,
              and real feedback from couples and peers. This isn't about being
              "better than" — it's about having done the work.
            </p>
            <h3 class="text-dark mb-3 text-sm" style="font-weight: 600;">
              Requirements
            </h3>
            <ul class="space-y-2.5">
              <li
                class="text-light flex items-start gap-2.5 text-sm"
                style="font-weight: 400;"
              >
                <svg
                  class="mt-0.5 h-4 w-4 flex-none"
                  style="color: #92174d;"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  ><path
                    d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"
                  ></path></svg
                >
                Meets the standard of Registered, plus:
              </li>
              <li
                class="text-light flex items-start gap-2.5 text-sm"
                style="font-weight: 400;"
              >
                <svg
                  class="mt-0.5 h-4 w-4 flex-none"
                  style="color: #92174d;"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  ><path
                    d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"
                  ></path></svg
                >
                3+ years registered as a marriage celebrant
              </li>
              <li
                class="text-light flex items-start gap-2.5 text-sm"
                style="font-weight: 400;"
              >
                <svg
                  class="mt-0.5 h-4 w-4 flex-none"
                  style="color: #92174d;"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  ><path
                    d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"
                  ></path></svg
                >
                Current professional indemnity insurance (certificate of currency)
              </li>
              <li
                class="text-light flex items-start gap-2.5 text-sm"
                style="font-weight: 400;"
              >
                <svg
                  class="mt-0.5 h-4 w-4 flex-none"
                  style="color: #92174d;"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  ><path
                    d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"
                  ></path></svg
                >
                Professional development beyond legislative OPD requirements
              </li>
              <li
                class="text-light flex items-start gap-2.5 text-sm"
                style="font-weight: 400;"
              >
                <svg
                  class="mt-0.5 h-4 w-4 flex-none"
                  style="color: #92174d;"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  ><path
                    d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"
                  ></path></svg
                >
                6+ verified reviews from couples they have married
              </li>
              <li
                class="text-light flex items-start gap-2.5 text-sm"
                style="font-weight: 400;"
              >
                <svg
                  class="mt-0.5 h-4 w-4 flex-none"
                  style="color: #92174d;"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  ><path
                    d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"
                  ></path></svg
                >
                3+ verified reviews from fellow wedding vendors
              </li>
              <li
                class="text-light flex items-start gap-2.5 text-sm"
                style="font-weight: 400;"
              >
                <svg
                  class="mt-0.5 h-4 w-4 flex-none"
                  style="color: #92174d;"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  ><path
                    d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"
                  ></path></svg
                >
                Proof of 100+ ceremonies performed
              </li>
            </ul>
            <a
              href="/endorsed/"
              class="mt-6 inline-flex items-center gap-1.5 text-sm no-underline hover:underline"
              style="font-weight: 500; color: #92174d;"
            >
              View all endorsed celebrants
              <svg
                class="h-4 w-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                ><path
                  d="M5 12h14m-7-7l7 7-7 7"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path></svg
              >
            </a>
          </div>
        </div>

        {/* Luminary */}
        <div class="">
          <div
            class="rounded-card h-full border-2 p-8 md:p-10"
            style="border-color: #460479;"
          >
            <div class="mb-6">
              <div
                class="inline-flex items-center gap-2 rounded-full px-4 py-1.5 text-sm text-white"
                style="font-weight: 600; background: #460479;"
              >
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  ><path
                    d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"
                  ></path></svg
                >
                Luminary
              </div>
            </div>
            <h2
              class="mb-3 text-xl"
              style="font-weight: 700; letter-spacing: -0.18px;"
            >
              Luminary Celebrant
            </h2>
            <p
              class="text-light mb-6 text-sm"
              style="font-weight: 400; line-height: 1.6;"
            >
              The highest credential Australian Wedding Celebrants issues. Its
              standard calls for substantial experience, documented feedback,
              industry recognition, professional development, and a maintained
              digital presence. The credential is human verified when issued; it
              does not promise current availability or commercial activity.
            </p>
            <h3 class="text-dark mb-3 text-sm" style="font-weight: 600;">
              Requirements
            </h3>
            <ul class="space-y-2.5">
              <li
                class="text-light flex items-start gap-2.5 text-sm"
                style="font-weight: 400;"
              >
                <svg
                  class="mt-0.5 h-4 w-4 flex-none"
                  style="color: #460479;"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  ><path
                    d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"
                  ></path></svg
                >
                Meets the requirements of Endorsed, plus:
              </li>
              <li
                class="text-light flex items-start gap-2.5 text-sm"
                style="font-weight: 400;"
              >
                <svg
                  class="mt-0.5 h-4 w-4 flex-none"
                  style="color: #460479;"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  ><path
                    d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"
                  ></path></svg
                >
                7+ years registered or practising, supported by dated evidence
              </li>
              <li
                class="text-light flex items-start gap-2.5 text-sm"
                style="font-weight: 400;"
              >
                <svg
                  class="mt-0.5 h-4 w-4 flex-none"
                  style="color: #460479;"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  ><path
                    d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"
                  ></path></svg
                >
                18+ verified or public reviews from couples they have married
              </li>
              <li
                class="text-light flex items-start gap-2.5 text-sm"
                style="font-weight: 400;"
              >
                <svg
                  class="mt-0.5 h-4 w-4 flex-none"
                  style="color: #460479;"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  ><path
                    d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"
                  ></path></svg
                >
                9+ verified or public reviews from fellow wedding industry professionals
                — people who see a lot of celebrants and can speak to what sets this
                one apart
              </li>
              <li
                class="text-light flex items-start gap-2.5 text-sm"
                style="font-weight: 400;"
              >
                <svg
                  class="mt-0.5 h-4 w-4 flex-none"
                  style="color: #460479;"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  ><path
                    d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"
                  ></path></svg
                >
                Industry recognition: awards (ABIA, Easy Weddings, etc.), media features,
                published work, or conference speaking
              </li>
              <li
                class="text-light flex items-start gap-2.5 text-sm"
                style="font-weight: 400;"
              >
                <svg
                  class="mt-0.5 h-4 w-4 flex-none"
                  style="color: #460479;"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  ><path
                    d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"
                  ></path></svg
                >
                Demonstrated ongoing professional development beyond legislative requirements
              </li>
              <li
                class="text-light flex items-start gap-2.5 text-sm"
                style="font-weight: 400;"
              >
                <svg
                  class="mt-0.5 h-4 w-4 flex-none"
                  style="color: #460479;"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  ><path
                    d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"
                  ></path></svg
                >
                Maintained professional website and evidence of responsive enquiry
                handling
              </li>
              <li
                class="text-light flex items-start gap-2.5 text-sm"
                style="font-weight: 400;"
              >
                <svg
                  class="mt-0.5 h-4 w-4 flex-none"
                  style="color: #460479;"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  ><path
                    d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"
                  ></path></svg
                >
                Uses a professional email address on their own domain (not a free
                Hotmail, Gmail, or similar account)
              </li>
            </ul>
            <a
              href="/luminaries/"
              class="mt-6 inline-flex items-center gap-1.5 text-sm no-underline hover:underline"
              style="font-weight: 500; color: #460479;"
            >
              View all luminary celebrants
              <svg
                class="h-4 w-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                ><path
                  d="M5 12h14m-7-7l7 7-7 7"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path></svg
              >
            </a>
          </div>
        </div>
      </div>
