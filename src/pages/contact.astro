---
import Base from "@/layouts/Base.astro";
import type { CollectionEntry } from "astro:content";
import { getEntry } from "astro:content";
import config from "@/config/config.json";

const entry = (await getEntry("pages", "contact")) as CollectionEntry<"pages">;
const { title, description, meta_title, image } = entry.data;
---

<Base
  title={title}
  meta_title={meta_title}
  description={description}
  image={image}
>
  <section class="py-16 md:py-20">
    <div class="container max-w-2xl">
      {/* Header */}
      <div class="mb-12 text-center">
        <h1 style="font-weight: 700; letter-spacing: -0.44px;">Get in Touch</h1>
        <p
          class="text-light mx-auto mt-4 max-w-xl"
          style="font-weight: 400; line-height: 1.6;"
        >
          Have a question about the website, our standards, or need help with
          your listing? We'd love to hear from you.
        </p>
      </div>

      {/* Info callout */}
      <div class="rounded-card border-border bg-theme-light mb-10 border p-6">
        <div class="flex items-start gap-3">
          <svg
            class="text-light mt-0.5 h-5 w-5 flex-none"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path
              d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"
            ></path>
          </svg>
          <div>
            <p class="text-dark text-sm" style="font-weight: 500;">
              Looking to book a celebrant?
            </p>
            <p class="text-light mt-1 text-sm" style="font-weight: 400;">
              This form is not for booking celebrants. To contact a celebrant
              about your wedding, visit their profile in the <a
                href="/directory/"
                class="text-dark hover:text-primary underline">directory</a
              > and use the contact details on their page.
            </p>
          </div>
        </div>
      </div>

      {/* Form */}
      <section
        id="profile-corrections"
        class="rounded-card border-border bg-theme-light mb-10 border p-6"
      >
        <h2 class="text-dark mb-2 text-base" style="font-weight: 600;">
          Profile corrections and updates
        </h2>
        <p class="text-light text-sm" style="line-height: 1.6;">
          Anyone can report inaccurate or out-of-date profile information here;
          no sign-in is required. Include the profile URL, the change needed, and
          a public source where one is available. Profile owners can use this
          route too, or sign in separately for routine edits.
        </p>
      </section>

      <form
        class="space-y-6"
        method="post"
        action={config.params.contact_form_action}
      >
        <div class="grid grid-cols-1 gap-8 sm:grid-cols-2">
          <div>
            <label
              class="text-dark mb-2 block text-sm"
              style="font-weight: 600;"
            >
              Your Name <span class="text-primary">*</span>
            </label>
            <input
              class="form-input w-full"
              name="name"
              type="text"
              required
              placeholder="e.g. Sarah Mitchell"
            />
          </div>
          <div>
            <label
              class="text-dark mb-2 block text-sm"
              style="font-weight: 600;"
            >
              Email Address <span class="text-primary">*</span>
            </label>
            <input
              class="form-input w-full"
              name="email"
              type="email"
              required
              placeholder="hello@example.com"
            />
          </div>
        </div>

        <div>
          <label class="text-dark mb-2 block text-sm" style="font-weight: 600;">
            What can we help with? <span class="text-primary">*</span>
          </label>
          <select name="subject" required class="form-input w-full">
            <option value="">Select a topic...</option>
            <option value="listing_help">Help with my listing</option>
            <option value="tier_question"
              >Question about tiers / standards</option
            >
            <option value="website_issue">Report a website issue</option>
            <option value="profile_correction">Profile correction or update</option>
            <option value="general">General enquiry</option>
          </select>
        </div>

        <div>
          <label class="text-dark mb-2 block text-sm" style="font-weight: 600;">
            Profile URL <span class="text-light" style="font-weight: 400;">(if applicable)</span>
          </label>
          <input
            class="form-input w-full"
            name="profile_url"
            type="url"
            placeholder="https://australianweddingcelebrants.com.au/directory/.../"
          />
        </div>

        <div>
          <label class="text-dark mb-2 block text-sm" style="font-weight: 600;">
            Message <span class="text-primary">*</span>
          </label>
          <textarea
            class="form-textarea w-full"
            name="message"
            rows="5"
            required
            placeholder="Tell us how we can help..."></textarea>
        </div>

        {/* Honeypot */}
        <div style="position:absolute;left:-9999px" aria-hidden="true">
          <input type="text" name="_hp" tabindex="-1" autocomplete="off" />
        </div>

        <div>
          <button type="submit" class="btn btn-primary px-10">
            Send Message
          </button>
          <p class="text-light mt-3 text-xs" style="font-weight: 400;">
            We'll get back to you as soon as we can.
          </p>
        </div>
      </form>

      {/* Quick links */}
      <div class="border-border mt-16 border-t pt-12 text-center">
        <h2
          class="mb-6 text-base"
          style="font-weight: 600; letter-spacing: -0.18px;"
        >
          Quick links
        </h2>
        <div class="flex flex-wrap justify-center gap-3">
          <a
            href="https://api.australianweddingcelebrants.com.au/login"
            class="border-border text-dark hover:border-dark hover:shadow-hover inline-block rounded-full border bg-white px-5 py-2.5 text-sm no-underline transition-all duration-200"
            style="font-weight: 500;"
          >
            Join or edit your listing
          </a>
          <a
            href="/tiers/"
            class="border-border text-dark hover:border-dark hover:shadow-hover inline-block rounded-full border bg-white px-5 py-2.5 text-sm no-underline transition-all duration-200"
            style="font-weight: 500;"
          >
            Our standards
          </a>
          <a
            href="/directory/"
            class="border-border text-dark hover:border-dark hover:shadow-hover inline-block rounded-full border bg-white px-5 py-2.5 text-sm no-underline transition-all duration-200"
            style="font-weight: 500;"
          >
            Browse directory
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>
