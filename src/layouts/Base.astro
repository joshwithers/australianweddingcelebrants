---
import config from "../config/config.json";
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import type { ImageMetadata } from "astro";
import { plainify, truncateText } from "../lib/utils/textConverter";
import { serializeJsonLd } from "../lib/utils/jsonLd";
import { PUBLISHER } from "../lib/siteProvenance";
import Footer from "./partials/Footer.astro";
import Header from "./partials/Header.astro";
import "../styles/main.css";

export interface Props {
  title?: string;
  meta_title?: string;
  description?: string;
  image?: string | ImageMetadata;
  noindex?: boolean;
  canonical?: string;
  /** OpenGraph object type — "website" (default), "profile" for celebrant pages, etc. */
  og_type?: string;
  /** Optional hex colour applied to the body background so the translucent header picks it up. */
  page_bg?: string;
  /** Mobile browser chrome colour. Defaults to page_bg, then to white. Match the
   *  page's top-of-page colour so the URL bar feels seamless on Safari/Chrome mobile. */
  theme_color?: string;
  /** Set only for genuine editorial content. Directory/profile records have no author. */
  author?: string;
  /** Optional above-the-fold background image that should be discovered before CSS. */
  preload_image?: string;
}

const {
  title,
  meta_title,
  description,
  image: rawImage,
  noindex,
  canonical,
  og_type = "website",
  page_bg,
  theme_color,
  author,
  preload_image,
} = Astro.props;

// Browser chrome colour — explicit override > page bg > white.
const themeColor = theme_color || page_bg || "#ffffff";

// Resolve image to string (local images are objects with .src)
const image = typeof rawImage === "object" && rawImage?.src ? rawImage.src : rawImage;
const canonicalUrl = canonical || `${config.site.base_url}${Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/$/, '') + '/'}`;
const canonicalPath = new URL(canonicalUrl).pathname;
const markdownUrl = `${config.site.base_url}${canonicalPath === '/' ? '/index.md' : `${canonicalPath.replace(/\/$/, '')}.md`}`;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    {preload_image && <link rel="preload" as="image" href={preload_image} fetchpriority="high" />}

    <!-- favicon -->
    <link rel="icon" type="image/svg+xml" href={config.site.favicon} />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- title -->
    <title>
      {plainify(meta_title ? meta_title : title ? title : config.site.title)}
    </title>

    <!-- canonical url -->
    <link rel="canonical" href={canonicalUrl} />
    {!noindex && <link rel="alternate" type="text/markdown" href={markdownUrl} />}
    {!noindex && <link rel="alternate" type="application/rss+xml" title="Australian Wedding Celebrants editorial feed" href="/rss.xml" />}
    {!noindex && <link rel="help" href="/llms.txt" />}

    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <!-- meta-description -->
    <meta
      name="description"
      content={truncateText(plainify(
        description ? description : config.metadata.meta_description
      ), 160)}
    />

    <!-- Cookieless GA4 measurement. Consent defaults are deliberately queued
         before gtag.js is requested and are never upgraded in this public site. -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      window.gtag = window.gtag || function () { window.dataLayer.push(arguments); };
      window.gtag("consent", "default", {
        analytics_storage: "denied",
        ad_storage: "denied",
        ad_user_data: "denied",
        ad_personalization: "denied"
      });
    </script>
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-DCYE3SSJQV"></script>
    <script is:inline>
      if (!window.__awcGa4Configured) {
        window.__awcGa4Configured = true;
        window.gtag("set", "allow_google_signals", false);
        window.gtag("set", "allow_ad_personalization_signals", false);
        window.gtag("set", "ads_data_redaction", true);
        window.gtag("js", new Date());
        window.gtag("config", "G-DCYE3SSJQV", {
          send_page_view: false,
          allow_google_signals: false,
          allow_ad_personalization_signals: false
        });

        document.addEventListener("astro:page-load", function () {
          let referrerOrigin = "";
          try {
            referrerOrigin = document.referrer
              ? new URL(document.referrer).origin
              : "";
          } catch {
            referrerOrigin = "";
          }

          window.gtag("event", "page_view", {
            page_title: document.title,
            page_location: window.location.origin + window.location.pathname,
            page_referrer: referrerOrigin
          });
        });
      }
    </script>

    <Font
      cssVariable="--font-inter"
      preload={[
        { weight: 400, style: "normal", subset: "latin" },
        { weight: 700, style: "normal", subset: "latin" }
      ]}
    />

    <ClientRouter />

    <!-- theme meta -->
    <meta name="theme-color" content={themeColor} />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    {author && <meta name="author" content={author} />}

    <!-- Open Graph -->
    <meta property="og:title" content={plainify(meta_title ? meta_title : title ? title : config.site.title)} />
    <meta property="og:description" content={truncateText(plainify(description ? description : config.metadata.meta_description), 160)} />
    <meta property="og:type" content={og_type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={image && typeof image === 'string' && image.startsWith('http') ? image : `${config.site.base_url}${image || config.metadata.meta_image}`} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={plainify(meta_title ? meta_title : title ? title : config.site.title)} />
    <meta name="twitter:description" content={truncateText(plainify(description ? description : config.metadata.meta_description), 160)} />
    <meta name="twitter:image" content={image && typeof image === 'string' && image.startsWith('http') ? image : `${config.site.base_url}${image || config.metadata.meta_image}`} />

    <!-- WebMCP — expose key site actions to AI agents running in the browser.
         Feature-detects navigator.modelContext, no-op elsewhere. -->
    <script is:inline src="/webmcp.js" defer></script>

    <!-- Structured data -->
    <script is:inline type="application/ld+json" set:html={serializeJsonLd({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "@id": `${config.site.base_url}/#website`,
      "name": config.site.title,
      "url": config.site.base_url,
      "description": truncateText(plainify(description ? description : config.metadata.meta_description), 160),
      "publisher": {
        "@type": "Organization",
        "@id": PUBLISHER.id,
        "name": PUBLISHER.name,
        "url": PUBLISHER.url,
        "identifier": {
          "@type": "PropertyValue",
          "propertyID": "ABN",
          "value": PUBLISHER.abn
        }
      },
      "inLanguage": "en-AU",
      "potentialAction": {
        "@type": "SearchAction",
        "target": `${config.site.base_url}/search/?q={search_term_string}`,
        "query-input": "required name=search_term_string"
      }
    })} />

  </head>
  <body
    data-page={Astro.url.pathname === "/" ? "home" : undefined}
    data-page-bg={page_bg ? "" : undefined}
    style={page_bg ? `background-color: ${page_bg}; --page-bg: ${page_bg};` : undefined}
  >
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
