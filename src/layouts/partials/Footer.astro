---
import config from "@/config/config.json";
import menu from "@/config/menu.json";
import { CAPITAL_CITIES } from "@/lib/capitalCities";
import { markdownify, slugify } from "@/lib/utils/textConverter";
import { CORRECTIONS_PATH, PUBLISHER } from "@/lib/siteProvenance";
---

<footer class="site-footer">
  <div class="container footer-content">
    <a
      class="footer-brand"
      href="/"
      aria-label="Australian Wedding Celebrants home"
    >
      <img src="/favicon.svg" width="48" height="44" alt="" loading="lazy" />
      <span>
        Australian
        <br />
        Wedding Celebrants
      </span>
    </a>

    <div class="footer-navigation">
      <nav aria-labelledby="footer-cities-title">
        <h2 id="footer-cities-title">Find your celebrant</h2>
        <ul class="footer-links footer-cities">
          {CAPITAL_CITIES.map((city) => (
            <li>
              <a href={`/directory/location/${slugify(city)}/`}>{city}</a>
            </li>
          ))}
        </ul>
      </nav>
      <nav aria-labelledby="footer-directory-title">
        <h2 id="footer-directory-title">Explore the directory</h2>
        <ul class="footer-links footer-resources">
          {menu.footer.map((item) => (
            <li>
              <a href={item.url}>{item.name}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="footer-publisher">
      <p
        class="footer-copyright"
        set:html={markdownify(config.params.copyright)}
      />
      <div data-site-provenance class="footer-provenance">
        <p>
          Responsible publisher: <a href={PUBLISHER.url}>{PUBLISHER.name}</a>,
          ABN {PUBLISHER.abn}.{" "}
          <a href={CORRECTIONS_PATH}>Request a correction or profile update</a>{" "}
          — no sign-in required.
        </p>
      </div>
    </div>

    <div class="footer-credits">
      <p class="footer-project">
        <svg
          width="12"
          height="16"
          viewBox="0 0 20 24"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M10 1c0 7-2 10-9 11 7 1 9 4 9 11 0-7 2-10 9-11-7-1-9-4-9-11Z"
            fill="currentColor"
          />
        </svg>
        <span>
          Another <strong>Withers Co</strong> project
        </span>
      </p>
      <p class="footer-signoff">
        <span class="signoff-phrase">
          Another <a href="https://unpopular.au/">Unpopular</a>
        </span>
        <span class="signoff-phrase">
          website on <a href="https://theinternet.com.au/">The Internet</a>
        </span>
        <span class="signoff-phrase">
          by <a href="https://joshwithers.au/">Josh</a>
        </span>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    isolation: isolate;
    color: #51273b;
    background: #ffedef;
    border-top: 1px solid #e7bfcc;
  }
  .site-footer::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: url("/hero-bg.svg") center / cover;
    opacity: 0.24;
    pointer-events: none;
  }
  .footer-content {
    padding-top: 48px;
    padding-bottom: max(32px, env(safe-area-inset-bottom));
  }
  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    color: #86244c;
    text-decoration: none;
    font-size: 20px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.5px;
  }
  .footer-brand img {
    flex: none;
    width: 48px;
    height: 44px;
  }
  .footer-navigation {
    display: grid;
    gap: 32px;
    margin-top: 36px;
    margin-bottom: 32px;
  }
  .footer-navigation h2 {
    color: #86244c;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0;
    margin: 0 0 12px;
  }
  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    column-gap: 20px;
  }
  .footer-cities {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .footer-links a {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 8px 0;
    color: #51273b;
    text-decoration: none;
    font-size: 15px;
    line-height: 1.4;
    text-underline-offset: 4px;
  }
  .footer-links a:hover {
    color: #86244c;
    text-decoration: underline;
  }
  .site-footer a:focus-visible {
    outline: 2px solid #86244c;
    outline-offset: 5px;
    border-radius: 3px;
  }
  .footer-publisher {
    border-top: 1px solid #dcb4c3;
    padding-top: 28px;
    text-align: center;
  }
  .footer-copyright {
    margin: 0;
    font-size: 14px;
    line-height: 1.8;
  }
  .footer-copyright :global(a) {
    color: #86244c;
    font-weight: 600;
    text-underline-offset: 4px;
  }
  .footer-provenance {
    max-width: 720px;
    margin: 12px auto 0;
    color: #705162;
    font-size: 12px;
    line-height: 1.9;
    text-wrap: pretty;
  }
  .footer-provenance p {
    margin: 0;
  }
  .footer-provenance a {
    color: inherit;
    text-decoration-color: #ba8c9d;
    text-underline-offset: 3px;
  }
  .footer-credits {
    margin-top: 36px;
    text-align: center;
  }
  .footer-project {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    margin: 0 0 8px;
    color: #86244c;
    font-size: 14px;
    font-style: italic;
    letter-spacing: 0.01em;
  }
  .footer-project strong {
    font-weight: 600;
  }
  .footer-project svg {
    flex: none;
    transform: rotate(12deg);
  }
  .footer-signoff {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0 9px;
    margin: 0;
    color: #705162;
    font-size: 13px;
    line-height: 1.6;
  }
  .signoff-phrase {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    white-space: nowrap;
  }
  .footer-signoff a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: #86244c;
    font-weight: 600;
    text-decoration-line: underline;
    text-decoration-color: #c78ca4;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
    transition:
      color 160ms ease,
      text-decoration-color 160ms ease;
  }
  .footer-signoff a:hover {
    color: #51273b;
    text-decoration-color: #51273b;
    text-decoration-style: wavy;
  }
  @media (min-width: 480px) {
    .footer-resources {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 768px) {
    .footer-content {
      padding-top: 56px;
      padding-bottom: 40px;
    }
    .footer-navigation {
      grid-template-columns: 1fr 1.4fr;
      gap: 64px;
      margin-top: 40px;
      margin-bottom: 40px;
    }
    .footer-brand {
      font-size: 22px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .footer-signoff a {
      transition: none;
    }
  }
</style>
