---
import config from "@/config/config.json";
import menu from "@/config/menu.json";
import { CAPITAL_CITIES } from "@/lib/capitalCities";
import { markdownify, slugify } from "@/lib/utils/textConverter";
import { CORRECTIONS_PATH, PUBLISHER } from "@/lib/siteProvenance";
---

<footer class="site-footer">
  <div class="container footer-content">
    <a
      class="footer-brand"
      href="/"
      aria-label="Australian Wedding Celebrants home"
    >
      <img src="/favicon.svg" width="48" height="44" alt="" loading="lazy" />
      <span>
        Australian
        <br />
        Wedding Celebrants
      </span>
    </a>

    <div class="footer-navigation">
      <nav aria-labelledby="footer-cities-title">
        <h2 id="footer-cities-title">Find your celebrant</h2>
        <ul class="footer-links footer-cities">
          {CAPITAL_CITIES.map((city) => (
            <li>
              <a href={`/directory/location/${slugify(city)}/`}>{city}</a>
            </li>
          ))}
        </ul>
      </nav>
      <nav aria-labelledby="footer-directory-title">
        <h2 id="footer-directory-title">Explore the directory</h2>
        <ul class="footer-links footer-resources">
          {menu.footer.map((item) => (
            <li>
              <a href={item.url}>{item.name}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="footer-publisher">
      <p
        class="footer-copyright"
        set:html={markdownify(config.params.copyright)}
      />
      <details data-site-provenance class="footer-provenance">
        <summary>Publisher details &amp; corrections</summary>
        <p>
          Responsible publisher: <a href={PUBLISHER.url}>{PUBLISHER.name}</a>,
          ABN {PUBLISHER.abn}.{" "}
          <a href={CORRECTIONS_PATH}>Request a correction or profile update</a>{" "}—
          no sign-in required.
        </p>
      </details>
    </div>

    <p class="footer-signoff">
      <span class="signoff-phrase">
        <span class="signoff-small">Another</span>
        <a
          class="signoff-sticker signoff-unpopular"
          href="https://unpopular.au/"
        >
          Unpopular
        </a>
      </span>
      <span class="signoff-phrase">
        <span class="signoff-small">website on</span>
        <a
          class="signoff-sticker signoff-internet"
          href="https://theinternet.com.au/"
        >
          The Internet
          <svg
            class="signoff-sparkle"
            width="20"
            height="24"
            viewBox="0 0 20 24"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M10 1c0 7-2 10-9 11 7 1 9 4 9 11 0-7 2-10 9-11-7-1-9-4-9-11Z"
              fill="currentColor"
            />
          </svg>
        </a>
      </span>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    isolation: isolate;
    color: #51273b;
    background: #ffedef;
    border-top: 1px solid #e7bfcc;
  }
  .site-footer::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: url("/hero-bg.svg") center / cover;
    opacity: 0.24;
    pointer-events: none;
  }
  .footer-content {
    padding-top: 48px;
    padding-bottom: max(32px, env(safe-area-inset-bottom));
  }
  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    color: #86244c;
    text-decoration: none;
    font-size: 20px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.5px;
  }
  .footer-brand img {
    flex: none;
    width: 48px;
    height: 44px;
  }
  .footer-navigation {
    display: grid;
    gap: 32px;
    margin-top: 36px;
    margin-bottom: 32px;
  }
  .footer-navigation h2 {
    color: #86244c;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0;
    margin: 0 0 12px;
  }
  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    column-gap: 20px;
  }
  .footer-cities {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .footer-links a {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 8px 0;
    color: #51273b;
    text-decoration: none;
    font-size: 15px;
    line-height: 1.4;
    text-underline-offset: 4px;
  }
  .footer-links a:hover {
    color: #86244c;
    text-decoration: underline;
  }
  .site-footer a:focus-visible,
  summary:focus-visible {
    outline: 2px solid #86244c;
    outline-offset: 5px;
    border-radius: 3px;
  }
  .footer-publisher {
    border-top: 1px solid #dcb4c3;
    padding-top: 24px;
  }
  .footer-copyright {
    margin: 0;
    font-size: 14px;
    line-height: 1.8;
  }
  .footer-copyright :global(a) {
    color: #86244c;
    font-weight: 600;
    text-underline-offset: 4px;
  }
  .footer-provenance {
    max-width: 620px;
    font-size: 12px;
    line-height: 1.7;
  }
  .footer-provenance summary {
    cursor: pointer;
    padding: 12px 0;
    min-height: 44px;
    width: fit-content;
  }
  .footer-provenance p {
    margin: 0 0 16px;
  }
  .footer-provenance a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .footer-signoff {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 16px 22px;
    margin: 24px 0 0;
    padding: 24px 0 8px;
  }
  .signoff-phrase {
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }
  .signoff-small {
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .signoff-sticker {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 10px 17px;
    border: 1px solid #86244c;
    border-radius: 999px;
    color: #86244c;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    box-shadow: 0 3px 0 #86244c;
    transition:
      transform 180ms ease,
      box-shadow 180ms ease;
  }
  .signoff-unpopular {
    background: #f3c7d8;
    transform: rotate(-4deg);
  }
  .signoff-internet {
    background: #fff5df;
    transform: rotate(3deg);
  }
  .signoff-sticker:hover {
    transform: translateY(-3px) rotate(0);
    box-shadow: 0 6px 0 #86244c;
  }
  .signoff-sticker:active {
    transform: translateY(2px);
    box-shadow: 0 1px 0 #86244c;
  }
  .signoff-sparkle {
    position: absolute;
    right: -9px;
    top: -12px;
    transform: rotate(12deg);
  }
  @media (min-width: 480px) {
    .footer-resources {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 768px) {
    .footer-content {
      padding-top: 56px;
      padding-bottom: 40px;
    }
    .footer-navigation {
      grid-template-columns: 1fr 1.4fr;
      gap: 64px;
      margin-top: 40px;
      margin-bottom: 40px;
    }
    .footer-brand {
      font-size: 22px;
    }
    .footer-publisher {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      justify-content: space-between;
      gap: 8px 32px;
    }
    .footer-provenance {
      max-width: 480px;
    }
    .footer-signoff {
      margin-top: 24px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .signoff-sticker {
      transition: none;
    }
    .signoff-sticker:hover,
    .signoff-sticker:active {
      transform: none;
    }
  }
</style>
